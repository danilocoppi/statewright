  },
  "project": {
    "id": "prj_orderLifecycle",
    "name": "Order lifecycle"
  },
  "root": "cnv_orderLifecycle",
  "catalog": {
    "types": {},
    "events": {
      "evt_orderCancelled": {
        "name": "order.cancelled",
        "payload": null,
        "source": "pty_customer"
      },
      "evt_orderPlaced": {
        "name": "order.placed",
        "payload": null,
        "source": "pty_customer"
      },
      "evt_paymentCaptured": {
        "name": "payment.captured",
        "payload": null,
        "source": "internal"
      },
      "evt_returnApproved": {
        "name": "return.approved",
        "payload": null,
        "source": "internal"
      },
      "evt_returnRequested": {
        "name": "return.requested",
        "payload": null,
        "source": "pty_customer"
      }
    },
    "actions": {
      "act_chargeCard": {
        "name": "Charge card",
        "emits": [
          "evt_paymentCaptured"
        ],
        "party": "pty_payments",
        "inner": {
          "canvas": "cnv_chargeCard"
        },
        "description": "Charges the order's total to the customer's card."
      },
      "act_refundCard": {
        "name": "Refund card",
        "party": "pty_payments",
        "description": "Gives the order's total back to the card."
      },
      "act_sendReceipt": {
        "name": "Send receipt",
        "party": "pty_customer"
      }
    },
    "guards": {},
    "endpoints": {
      "ept_pay": {
        "name": "Pay",
        "method": "POST",
        "path": "/orders/pay",
        "request": null,
        "responses": {
          "200": null
        }
      }
    },
    "webhooks": {},
    "timers": {},
    "statuses": {},
    "parties": {
      "pty_customer": {
        "kind": "human",
        "name": "Customer"
      },
      "pty_payments": {
        "kind": "system",
        "name": "Payments"
      }
    }
  },
  "definitions": {},
  "canvases": {
    "cnv_chargeCard": {
      "kind": "flow",
      "name": "Charge card",
      "nodes": {
        "nod_captured": {
          "kind": "emit",
          "event": "evt_paymentCaptured"
        },
        "nod_cardAccepted": {
          "kind": "if",
          "condition": {
            "text": "the card is accepted"
          }
        },
        "nod_chargeDeclined": {
          "kind": "end",
          "name": "Declined",
          "outcome": "failure"
        },
        "nod_chargeDone": {
          "kind": "end",
          "name": "Charged",
          "outcome": "success"
        },
        "nod_chargeStart": {
          "kind": "start"
        },
        "nod_markCharged": {
          "kind": "assign",
          "set": {
            "context.charged": true
          }
        }
      },
      "edges": {
        "edg_chargeAccepted": {
          "from": "nod_cardAccepted",
          "to": "nod_markCharged",
          "kind": "true"
        },
        "edg_chargeCheck": {
          "from": "nod_chargeStart",
          "to": "nod_cardAccepted"
        },
        "edg_chargeEnd": {
          "from": "nod_captured",
          "to": "nod_chargeDone"
        },
        "edg_chargeMark": {
          "from": "nod_markCharged",
          "to": "nod_captured"
        },
        "edg_chargeRefused": {
          "from": "nod_cardAccepted",
          "to": "nod_chargeDeclined",
          "kind": "false"
        }
      }
    },
    "cnv_checkout": {
      "kind": "flow",
      "name": "Checkout",
      "caption": "How the shop checks an order out: Payments is called, then the order is placed, which takes it to charging.",
      "nodes": {
        "nod_chargingHere": {
          "kind": "state",
          "target": "nod_charging"
        },
        "nod_checkoutDone": {
          "kind": "end",
          "name": "Checked out",
          "outcome": "success"
        },
        "nod_checkoutStart": {
          "kind": "start"
        },
        "nod_payCall": {
          "kind": "call",
          "name": "Authorise payment",
          "endpoint": "ept_pay",
          "party": "pty_payments"
        },
        "nod_paymentsInFlow": {
          "kind": "participant",
          "party": "pty_payments"
        },
        "nod_placeOrder": {
          "kind": "emit",
          "name": "Place the order",
          "event": "evt_orderPlaced"
        }
      },
      "edges": {
        "edg_checkoutEnd": {
          "from": "nod_placeOrder",
          "to": "nod_checkoutDone"
        },
        "edg_checkoutPay": {
          "from": "nod_checkoutStart",
          "to": "nod_payCall"
        },
        "edg_checkoutPlace": {
          "from": "nod_payCall",
          "to": "nod_placeOrder"
        }
      }
    },
    "cnv_order": {
      "kind": "machine",
      "name": "Order",
      "caption": "An order from the moment it is placed: the customer sends what moves it, Payments receives the charge, and the charge's steps run where it is called.",
      "subject": "order.status",
      "transitions": "complete",
      "nodes": {
        "nod_cancelled": {
          "kind": "state",
          "name": "cancelled",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_chargeSteps": {
          "kind": "steps",
          "action": "act_chargeCard"
        },
        "nod_charging": {
          "kind": "state",
          "name": "charging",
          "category": "processing"
        },
        "nod_created": {
          "kind": "state",
          "name": "created",
          "category": "waiting"
        },
        "nod_customerHere": {
          "kind": "participant",
          "party": "pty_customer"
        },
        "nod_init": {
          "kind": "initial"
        },
        "nod_paid": {
          "kind": "state",
          "name": "paid",
          "outcome": "success",
          "terminal": true,
          "onEntry": [
            {
              "action": "act_sendReceipt"
            }
          ]
        },
        "nod_paymentsHere": {
          "kind": "participant",
          "party": "pty_payments"
        }
      },
      "edges": {
        "edg_chargingCancelled": {
          "from": "nod_charging",
          "to": "nod_cancelled",
          "on": [
            "evt_orderCancelled"
          ],
          "intent": "failure"
        },
        "edg_chargingPaid": {
          "from": "nod_charging",
          "to": "nod_paid",
          "on": [
            "evt_paymentCaptured"
          ],
          "intent": "happy"
        },
        "edg_createdCancelled": {
          "from": "nod_created",
          "to": "nod_cancelled",
          "on": [
            "evt_orderCancelled"
          ]
        },
        "edg_createdCharging": {
          "from": "nod_created",
          "to": "nod_charging",
          "on": [
            "evt_orderPlaced"
          ],
          "actions": [
            {
              "action": "act_chargeCard"
            }
          ],
          "intent": "happy"
        },
        "edg_initCreated": {
          "from": "nod_init",
          "to": "nod_created"
        }
      }
    },
    "cnv_orderLifecycle": {
      "kind": "system",
      "name": "Order lifecycle",
      "caption": "A shop's orders: who places them, who charges them, and the order's lifecycle.",
      "nodes": {
        "nod_customer": {
          "kind": "actor",
          "name": "Customer",
          "party": "pty_customer"
        },
        "nod_orders": {
          "kind": "store",
          "name": "Orders",
          "inner": {
            "canvas": "cnv_order"
          }
        },
        "nod_payments": {
          "kind": "service",
          "name": "Payments",
          "party": "pty_payments"
        },
        "nod_returns": {
          "kind": "service",
          "name": "Returns",
          "inner": {
            "canvas": "cnv_returns"
          }
        },
        "nod_shop": {
          "kind": "service",
          "name": "Shop",
          "inner": {
            "canvas": "cnv_checkout"
          }
        }
      },
      "edges": {
        "edg_customerShop": {
          "from": "nod_customer",
          "to": "nod_shop",
          "kind": "command",
          "events": [
            "evt_orderPlaced"
          ]
        },
        "edg_shopOrders": {
          "from": "nod_shop",
          "to": "nod_orders",
          "kind": "data"
        },
        "edg_shopPayments": {
          "from": "nod_shop",
          "to": "nod_payments",
          "kind": "command"
        },
        "edg_shopReturns": {
          "from": "nod_shop",
          "to": "nod_returns",
          "kind": "command"
        }
      }
    },
    "cnv_returns": {
      "kind": "mixed",
      "name": "Returns desk",
      "caption": "A mixed level: a return's states, the steps that approve it, and who acts — the customer who asks, Payments who refunds.",
      "subject": "return.status",
      "nodes": {
        "nod_approve": {
          "kind": "emit",
          "name": "Approve the return",
          "event": "evt_returnApproved"
        },
        "nod_approveDone": {
          "kind": "end",
          "name": "Approved",
          "outcome": "success"
        },
        "nod_approveRefused": {
          "kind": "end",
          "name": "Refused",
          "outcome": "failure"
        },
        "nod_approveStart": {
          "kind": "start"
        },
        "nod_checkReturn": {
          "kind": "if",
          "condition": {
            "text": "the items came back"
          }
        },
        "nod_returnInit": {
          "kind": "initial"
        },
        "nod_returnNew": {
          "kind": "state",
          "name": "new",
          "category": "waiting"
        },
        "nod_returnRefunded": {
          "kind": "state",
          "name": "refunded",
          "outcome": "success",
          "terminal": true
        },
        "nod_returnRequested": {
          "kind": "state",
          "name": "requested",
          "category": "processing"
        },
        "nod_returnsCustomer": {
          "kind": "actor",
          "name": "Customer",
          "party": "pty_customer"
        },
        "nod_returnsPayments": {
          "kind": "service",
          "name": "Payments",
          "party": "pty_payments"
        }
      },
      "edges": {
        "edg_approveCheck": {
          "from": "nod_approveStart",
          "to": "nod_checkReturn"
        },
        "edg_approveEnd": {
          "from": "nod_approve",
          "to": "nod_approveDone"
        },
        "edg_approveNo": {
          "from": "nod_checkReturn",
          "to": "nod_approveRefused",
          "kind": "false"
        },
        "edg_approveYes": {
          "from": "nod_checkReturn",
          "to": "nod_approve",
          "kind": "true"
        },
        "edg_returnAsk": {
          "kind": "transition",
          "from": "nod_returnNew",
          "to": "nod_returnRequested",
          "on": [
            "evt_returnRequested"
          ]
        },
        "edg_returnRefund": {
          "kind": "transition",
          "from": "nod_returnRequested",
          "to": "nod_returnRefunded",
          "on": [
            "evt_returnApproved"
          ],
          "actions": [
            {
              "action": "act_refundCard"
            }
          ],
          "intent": "happy"
        },
        "edg_returnStart": {
          "kind": "transition",
          "from": "nod_returnInit",
          "to": "nod_returnNew"
        }
      }
    }
  },
  "annotations": {
    "lanes": {
      "lne_customer": {
        "canvas": "cnv_checkout",
        "label": "Customer",
        "nodes": [
          "nod_checkoutStart",
          "nod_placeOrder",
          "nod_checkoutDone"
        ],
        "party": "pty_customer"
      },
      "lne_payments": {
        "canvas": "cnv_checkout",
        "label": "Payments",
        "nodes": [
          "nod_payCall"
        ],
        "party": "pty_payments"
      }
    },
    "scenarios": {
      "scn_aDeclinedCard": {
        "name": "A declined card",
        "description": "The card is declined: the order waits in charging until the customer cancels it.",
        "canvas": "cnv_order",
        "start": {
          "at": "2026-03-02T10:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_orderPlaced"
            },
            "answers": [
              {
                "kind": "branch",
                "at": "nod_cardAccepted",
                "value": false
              }
            ],
            "reached": {
              "active": [
                "nod_charging"
              ]
            }
          },
          {
            "do": {
              "event": "evt_orderCancelled"
            },
            "reached": {
              "active": [
                "nod_cancelled"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_aPaidOrder": {
        "name": "A paid order",
        "description": "The customer places the order; the card is accepted, so the charge's own steps capture the payment and the order is paid.",
        "canvas": "cnv_order",
        "start": {
          "at": "2026-03-02T10:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_orderPlaced"
            },
            "answers": [
              {
                "kind": "branch",
                "at": "nod_cardAccepted",
                "value": true
              }
            ],
            "caption": "Customer places the order. Payments charges the card: accepted.",
            "reached": {
              "active": [
                "nod_paid"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_aRefundedReturn": {
        "name": "A refunded return",
        "description": "On the mixed level: the customer asks, the return is approved, and the card is refunded.",
        "canvas": "cnv_returns",
        "start": {
          "at": "2026-03-02T10:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_returnRequested"
            },
            "caption": "The customer asks to return the order.",
            "reached": {
              "active": [
                "nod_returnRequested"
              ]
            }
          },
          {
            "do": {
              "event": "evt_returnApproved"
            },
            "caption": "The return is approved; Payments refunds the card.",
            "reached": {
              "active": [
                "nod_returnRefunded"
              ],
              "ended": "done"
            }
          }
        ]
      }
    }
  },
