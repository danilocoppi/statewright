    "content": "ed916a3b73d89bf5e0c0d027ab3ff8355b395ef9656bd610a12d658518ab0af3",
    "annotations": "607529fb6eac20904a141efd98a99c1763730535185b12040aeeff7f5ec8b792",
    "layout": "058b782ed82ecfef3993094298bf3c3c20b1df811eff20522476f09fd71af0f4",
    "signedAt": "2026-10-15T12:00:00Z"
  },
  "project": {
    "id": "prj_orderLifecycle",
    "name": "Order lifecycle"
  },
  "root": "cnv_orderLifecycle",
  "catalog": {
    "types": {},
    "events": {
      "evt_orderCancelled": {
        "name": "order.cancelled",
        "payload": null,
        "source": "pty_customer"
      },
      "evt_orderPlaced": {
        "name": "order.placed",
        "payload": null,
        "source": "pty_customer"
      },
      "evt_paymentCaptured": {
        "name": "payment.captured",
        "payload": null,
        "source": "internal"
      }
    },
    "actions": {
      "act_chargeCard": {
        "name": "Charge card",
        "emits": [
          "evt_paymentCaptured"
        ],
        "party": "pty_payments",
        "inner": {
          "canvas": "cnv_chargeCard"
        },
        "description": "Charges the order's total to the customer's card."
      },
      "act_sendReceipt": {
        "name": "Send receipt",
        "party": "pty_customer"
      }
    },
    "guards": {},
    "endpoints": {
      "ept_pay": {
        "name": "Pay",
        "method": "POST",
        "path": "/orders/pay",
        "request": null,
        "responses": {
          "200": null
        }
      }
    },
    "webhooks": {},
    "timers": {},
    "statuses": {},
    "parties": {
      "pty_customer": {
        "kind": "human",
        "name": "Customer"
      },
      "pty_payments": {
        "kind": "system",
        "name": "Payments"
      }
    }
  },
  "definitions": {},
  "canvases": {
    "cnv_chargeCard": {
      "kind": "flow",
      "name": "Charge card",
      "nodes": {
        "nod_captured": {
          "kind": "emit",
          "event": "evt_paymentCaptured"
        },
        "nod_cardAccepted": {
          "kind": "if",
          "condition": {
            "text": "the card is accepted"
          }
        },
        "nod_chargeDeclined": {
          "kind": "end",
          "name": "Declined",
          "outcome": "failure"
        },
        "nod_chargeDone": {
          "kind": "end",
          "name": "Charged",
          "outcome": "success"
        },
        "nod_chargeStart": {
          "kind": "start"
        },
        "nod_markCharged": {
          "kind": "assign",
          "set": {
            "context.charged": true
          }
        }
      },
      "edges": {
        "edg_chargeAccepted": {
          "from": "nod_cardAccepted",
          "to": "nod_markCharged",
          "kind": "true"
        },
        "edg_chargeCheck": {
          "from": "nod_chargeStart",
          "to": "nod_cardAccepted"
        },
        "edg_chargeEnd": {
          "from": "nod_captured",
          "to": "nod_chargeDone"
        },
        "edg_chargeMark": {
          "from": "nod_markCharged",
          "to": "nod_captured"
        },
        "edg_chargeRefused": {
          "from": "nod_cardAccepted",
          "to": "nod_chargeDeclined",
          "kind": "false"
        }
      }
    },
    "cnv_checkout": {
      "kind": "flow",
      "name": "Checkout",
      "caption": "How the shop checks an order out: Payments is called, then the order is placed, which takes it to charging.",
      "nodes": {
        "nod_chargingHere": {
          "kind": "state",
          "target": "nod_charging"
        },
        "nod_checkoutDone": {
          "kind": "end",
          "name": "Checked out",
          "outcome": "success"
        },
        "nod_checkoutStart": {
          "kind": "start"
        },
        "nod_payCall": {
          "kind": "call",
          "name": "Authorise payment",
          "endpoint": "ept_pay",
          "party": "pty_payments"
        },
        "nod_paymentsInFlow": {
          "kind": "participant",
          "party": "pty_payments"
        },
        "nod_placeOrder": {
          "kind": "emit",
          "name": "Place the order",
          "event": "evt_orderPlaced"
        }
      },
      "edges": {
        "edg_checkoutEnd": {
          "from": "nod_placeOrder",
          "to": "nod_checkoutDone"
        },
        "edg_checkoutPay": {
          "from": "nod_checkoutStart",
          "to": "nod_payCall"
        },
        "edg_checkoutPlace": {
          "from": "nod_payCall",
          "to": "nod_placeOrder"
        }
      }
    },
    "cnv_order": {
      "kind": "machine",
      "name": "Order",
      "caption": "An order from the moment it is placed: the customer sends what moves it, Payments receives the charge, and the charge's steps run where it is called.",
      "subject": "order.status",
      "transitions": "complete",
      "nodes": {
        "nod_cancelled": {
          "kind": "state",
          "name": "cancelled",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_chargeSteps": {
          "kind": "steps",
          "action": "act_chargeCard"
        },
        "nod_charging": {
          "kind": "state",
          "name": "charging",
          "category": "processing"
        },
        "nod_created": {
          "kind": "state",
          "name": "created",
          "category": "waiting"
        },
        "nod_customerHere": {
          "kind": "participant",
          "party": "pty_customer"
        },
        "nod_init": {
          "kind": "initial"
        },
        "nod_paid": {
          "kind": "state",
          "name": "paid",
          "outcome": "success",
          "terminal": true,
          "onEntry": [
            {
              "action": "act_sendReceipt"
            }
          ]
        },
        "nod_paymentsHere": {
          "kind": "participant",
          "party": "pty_payments"
        }
      },
      "edges": {
        "edg_chargingCancelled": {
          "from": "nod_charging",
          "to": "nod_cancelled",
          "on": [
            "evt_orderCancelled"
          ],
          "intent": "failure"
        },
        "edg_chargingPaid": {
          "from": "nod_charging",
          "to": "nod_paid",
          "on": [
            "evt_paymentCaptured"
          ],
          "intent": "happy"
        },
        "edg_createdCancelled": {
          "from": "nod_created",
          "to": "nod_cancelled",
          "on": [
            "evt_orderCancelled"
          ]
        },
        "edg_createdCharging": {
          "from": "nod_created",
          "to": "nod_charging",
          "on": [
            "evt_orderPlaced"
          ],
          "actions": [
            {
              "action": "act_chargeCard"
            }
          ],
          "intent": "happy"
        },
        "edg_initCreated": {
          "from": "nod_init",
          "to": "nod_created"
        }
      }
    },
    "cnv_orderLifecycle": {
      "kind": "system",
      "name": "Order lifecycle",
      "caption": "A shop's orders: who places them, who charges them, and the order's lifecycle.",
      "nodes": {
        "nod_customer": {
          "kind": "actor",
          "name": "Customer",
          "party": "pty_customer"
        },
        "nod_orders": {
          "kind": "store",
          "name": "Orders",
          "inner": {
            "canvas": "cnv_order"
          }
        },
        "nod_payments": {
          "kind": "service",
          "name": "Payments",
          "party": "pty_payments"
        },
        "nod_shop": {
          "kind": "service",
          "name": "Shop",
          "inner": {
            "canvas": "cnv_checkout"
          }
        }
      },
      "edges": {
        "edg_customerShop": {
          "from": "nod_customer",
          "to": "nod_shop",
          "kind": "command",
          "events": [
            "evt_orderPlaced"
          ]
        },
        "edg_shopOrders": {
          "from": "nod_shop",
          "to": "nod_orders",
          "kind": "data"
        },
        "edg_shopPayments": {
          "from": "nod_shop",
          "to": "nod_payments",
          "kind": "command"
        }
      }
    }
  },
  "annotations": {
    "lanes": {
      "lne_customer": {
        "canvas": "cnv_checkout",
        "label": "Customer",
        "nodes": [
          "nod_checkoutStart",
          "nod_placeOrder",
          "nod_checkoutDone"
        ],
        "party": "pty_customer"
      },
      "lne_payments": {
        "canvas": "cnv_checkout",
        "label": "Payments",
        "nodes": [
          "nod_payCall"
        ],
        "party": "pty_payments"
      }
    },
    "scenarios": {
      "scn_aDeclinedCard": {
        "name": "A declined card",
        "description": "The card is declined: the order waits in charging until the customer cancels it.",
        "canvas": "cnv_order",
        "start": {
          "at": "2026-03-02T10:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_orderPlaced"
            },
            "answers": [
              {
                "kind": "branch",
                "at": "nod_cardAccepted",
                "value": false
              }
            ],
            "reached": {
              "active": [
                "nod_charging"
              ]
            }
          },
          {
            "do": {
              "event": "evt_orderCancelled"
            },
            "reached": {
              "active": [
                "nod_cancelled"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_aPaidOrder": {
        "name": "A paid order",
        "description": "The customer places the order; the card is accepted, so the charge's own steps capture the payment and the order is paid.",
        "canvas": "cnv_order",
        "start": {
          "at": "2026-03-02T10:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_orderPlaced"
            },
            "answers": [
              {
                "kind": "branch",
                "at": "nod_cardAccepted",
                "value": true
              }
            ],
            "caption": "Customer places the order. Payments charges the card: accepted.",
            "reached": {
              "active": [
                "nod_paid"
              ],
              "ended": "done"
            }
          }
        ]
      }
    }
  },
