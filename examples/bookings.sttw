{
  "statewright": "1.2",
  "generator": {
    "name": "statewright",
    "version": "0.1.1",
    "channel": "api"
  },
  "signature": {
    "algorithm": "sha256",
    "content": "8548f253fec3d7fd6f09767766350effa2701a8f2792267793a71a5a3f538b08",
    "annotations": "37451c33880e38f087617a714808a49b65e7f72910ccde56960a1211e74e3053",
    "layout": "5aa622e4f73a7f26d254b71250e1825b4275da0ce503d675d4a753287ff5e186",
    "signedAt": "2026-10-14T08:31:23Z"
  },
  "project": {
    "id": "prj_bookings",
    "name": "Bookings"
  },
  "root": "cnv_bookings",
  "catalog": {
    "types": {},
    "events": {
      "evt_bookingConfirmed": {
        "name": "booking.confirmed"
      },
      "evt_bookingDeclined": {
        "name": "booking.declined"
      },
      "evt_guestArrived": {
        "name": "guest.arrived"
      }
    },
    "actions": {},
    "guards": {},
    "endpoints": {
      "ept_answer": {
        "name": "Answer a booking",
        "method": "POST",
        "path": "/bookings/{id}/answer"
      },
      "ept_book": {
        "name": "Book a table",
        "method": "POST",
        "path": "/bookings"
      },
      "ept_sendSms": {
        "name": "Send an SMS",
        "method": "POST",
        "path": "/messages"
      }
    },
    "webhooks": {},
    "timers": {
      "tmr_grace": {
        "name": "grace period",
        "duration": "PT30M"
      }
    },
    "statuses": {},
    "parties": {
      "pty_guest": {
        "kind": "human",
        "name": "Guest"
      },
      "pty_sms": {
        "kind": "external",
        "name": "SMS provider"
      },
      "pty_staff": {
        "kind": "operator",
        "name": "Restaurant staff"
      }
    }
  },
  "definitions": {},
  "canvases": {
    "cnv_booking": {
      "kind": "machine",
      "name": "Booking lifecycle",
      "stage": "target",
      "subject": "booking.status",
      "transitions": "complete",
      "nodes": {
        "nod_book": {
          "kind": "entry",
          "name": "POST /bookings",
          "via": "ept_book",
          "by": "pty_guest"
        },
        "nod_confirmed": {
          "kind": "state",
          "name": "confirmed"
        },
        "nod_declined": {
          "kind": "state",
          "name": "declined",
          "outcome": "failure",
          "terminal": true
        },
        "nod_noShow": {
          "kind": "state",
          "name": "no-show",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_requested": {
          "kind": "state",
          "name": "requested",
          "category": "waiting"
        },
        "nod_seated": {
          "kind": "state",
          "name": "seated",
          "outcome": "success",
          "terminal": true
        }
      },
      "edges": {
        "edg_confirmedNoShow": {
          "from": "nod_confirmed",
          "to": "nod_noShow",
          "after": "tmr_grace",
          "intent": "failure"
        },
        "edg_confirmedSeated": {
          "from": "nod_confirmed",
          "to": "nod_seated",
          "on": [
            "evt_guestArrived"
          ],
          "intent": "happy"
        },
        "edg_postBookingsRequested": {
          "from": "nod_book",
          "to": "nod_requested"
        },
        "edg_requestedConfirmed": {
          "from": "nod_requested",
          "to": "nod_confirmed",
          "on": [
            "evt_bookingConfirmed"
          ],
          "intent": "happy"
        },
        "edg_requestedDeclined": {
          "from": "nod_requested",
          "to": "nod_declined",
          "on": [
            "evt_bookingDeclined"
          ],
          "intent": "failure"
        }
      }
    },
    "cnv_bookings": {
      "kind": "system",
      "name": "Bookings",
      "nodes": {
        "nod_bookingApi": {
          "kind": "service",
          "name": "Booking API",
          "inner": {
            "canvas": "cnv_booking"
          }
        },
        "nod_guest": {
          "kind": "actor",
          "name": "Guest",
          "party": "pty_guest"
        },
        "nod_notifier": {
          "kind": "service",
          "name": "Notifier",
          "inner": {
            "canvas": "cnv_textGuest"
          }
        },
        "nod_sms": {
          "kind": "external",
          "name": "SMS provider",
          "party": "pty_sms"
        },
        "nod_staff": {
          "kind": "actor",
          "name": "Restaurant staff",
          "party": "pty_staff"
        }
      },
      "edges": {
        "edg_bookingApiNotifier": {
          "from": "nod_bookingApi",
          "to": "nod_notifier",
          "kind": "event",
          "events": [
            "evt_bookingConfirmed",
            "evt_bookingDeclined"
          ]
        },
        "edg_guestBookingApi": {
          "from": "nod_guest",
          "to": "nod_bookingApi",
          "kind": "command",
          "endpoint": "ept_book"
        },
        "edg_notifierSmsProvider": {
          "from": "nod_notifier",
          "to": "nod_sms",
          "kind": "command",
          "endpoint": "ept_sendSms"
        },
        "edg_restaurantStaffBookingApi": {
          "from": "nod_staff",
          "to": "nod_bookingApi",
          "kind": "command",
          "endpoint": "ept_answer"
        }
      }
    },
    "cnv_textGuest": {
      "kind": "flow",
      "name": "Text the guest",
      "nodes": {
        "nod_sent": {
          "kind": "end",
          "name": "guest told"
        },
        "nod_sorry": {
          "kind": "call",
          "name": "send an apology",
          "endpoint": "ept_sendSms"
        },
        "nod_start": {
          "kind": "start"
        },
        "nod_welcome": {
          "kind": "call",
          "name": "send the confirmation",
          "endpoint": "ept_sendSms"
        },
        "nod_which": {
          "kind": "if",
          "name": "confirmed?",
          "condition": {
            "expr": {
              "==": [
                {
                  "var": "vars.input.event"
                },
                "booking.confirmed"
              ]
            },
            "text": "the restaurant confirmed the booking"
          }
        }
      },
      "edges": {
        "edg_confirmedSendAnApology": {
          "from": "nod_which",
          "to": "nod_sorry",
          "kind": "false"
        },
        "edg_confirmedSendTheConfirmation": {
          "from": "nod_which",
          "to": "nod_welcome",
          "kind": "true"
        },
        "edg_sendAnApologyGuestTold": {
          "from": "nod_sorry",
          "to": "nod_sent"
        },
        "edg_sendTheConfirmationGuestTold": {
          "from": "nod_welcome",
          "to": "nod_sent"
        },
        "edg_startConfirmed": {
          "from": "nod_start",
          "to": "nod_which"
        }
      }
    }
  },
  "annotations": {
    "scenarios": {
      "scn_aBookingIsDeclined": {
        "name": "A booking is declined",
        "description": "The restaurant has no table: it declines the booking.",
        "canvas": "cnv_booking",
        "start": {
          "at": "2026-01-09T19:00:00Z",
          "entry": "nod_book"
        },
        "steps": [
          {
            "do": {
              "event": "evt_bookingDeclined"
            },
            "reached": {
              "active": [
                "nod_declined"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_aConfirmedGuestIsSeated": {
        "name": "A confirmed guest is seated",
        "description": "The restaurant confirms the booking, and the guest arrives.",
        "canvas": "cnv_booking",
        "start": {
          "at": "2026-01-09T19:00:00Z",
          "entry": "nod_book"
        },
        "steps": [
          {
            "do": {
              "event": "evt_bookingConfirmed"
            },
            "reached": {
              "active": [
                "nod_confirmed"
              ]
            }
          },
          {
            "do": {
              "event": "evt_guestArrived"
            },
            "reached": {
              "active": [
                "nod_seated"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_aGuestDoesNotCome": {
        "name": "A guest does not come",
        "description": "The booking is confirmed, and the guest has not come when the grace period ends.",
        "canvas": "cnv_booking",
        "start": {
          "at": "2026-01-09T19:00:00Z",
          "entry": "nod_book"
        },
        "steps": [
          {
            "do": {
              "event": "evt_bookingConfirmed"
            },
            "reached": {
              "active": [
                "nod_confirmed"
              ]
            }
          },
          {
            "do": {
              "wait": "next"
            },
            "reached": {
              "active": [
                "nod_noShow"
              ],
              "ended": "done"
            }
          }
        ]
      },
      "scn_theGuestIsToldItIsConfirmed": {
        "name": "The guest is told it is confirmed",
        "description": "The Notifier hears booking.confirmed and sends the confirmation.",
        "canvas": "cnv_textGuest",
        "start": {
          "at": "2026-01-09T19:00:00Z",
          "input": {
            "event": "booking.confirmed"
          }
        },
        "steps": []
      },
      "scn_theGuestIsToldItIsDeclined": {
        "name": "The guest is told it is declined",
        "description": "The Notifier hears booking.declined and sends an apology.",
        "canvas": "cnv_textGuest",
        "start": {
          "at": "2026-01-09T19:00:00Z",
          "input": {
            "event": "booking.declined"
          }
        },
        "steps": []
      }
    }
  },
