        "edg_emz": {
          "from": "nod_reported",
          "to": "nod_matched",
          "on": [
            "evt_itemMatched"
          ]
        },
        "edg_en0": {
          "from": "nod_matched",
          "to": "nod_returned",
          "on": [
            "evt_itemCollected"
          ]
        },
        "edg_en1": {
          "from": "nod_reported",
          "to": "nod_unclaimed",
          "after": "tmr_keepFor"
        }
      }
    },
    "cnv_monthlyBilling": {
      "kind": "flow",
      "name": "Monthly billing",
      "nodes": {
        "nod_billEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_billStart": {
          "kind": "start"
        },
        "nod_eachOperator": {
          "kind": "forEach",
          "name": "each operator",
          "items": {
            "var": "vars.operators"
          },
          "as": "operator",
          "inner": {
            "canvas": "cnv_billOneOperator"
          }
        },
        "nod_movements": {
          "kind": "call",
          "name": "the month's movements",
          "endpoint": "ept_movements"
        }
      },
      "edges": {
        "edg_e1bp": {
          "from": "nod_billStart",
          "to": "nod_movements"
        },
        "edg_e1bq": {
          "from": "nod_movements",
          "to": "nod_eachOperator"
        },
        "edg_e1br": {
          "from": "nod_eachOperator",
          "to": "nod_billEnd"
        }
      }
    },
    "cnv_notifyPassengers": {
      "kind": "flow",
      "name": "Notify passengers",
      "nodes": {
        "nod_noticeSent": {
          "kind": "emit",
          "name": "notified",
          "event": "evt_passengerNotified"
        },
        "nod_notifyEnd": {
          "kind": "end"
        },
        "nod_notifyStart": {
          "kind": "start"
        },
        "nod_sendNotice": {
          "kind": "call",
          "name": "push, SMS and e-mail",
          "endpoint": "ept_sendAPush"
        },
        "nod_whoIsBooked": {
          "kind": "call",
          "name": "who is booked",
          "endpoint": "ept_boardingList"
        }
      },
      "edges": {
        "edg_e2s": {
          "from": "nod_notifyStart",
          "to": "nod_whoIsBooked"
        },
        "edg_e2t": {
          "from": "nod_whoIsBooked",
          "to": "nod_sendNotice"
        },
        "edg_e2u": {
          "from": "nod_sendNotice",
          "to": "nod_noticeSent"
        },
        "edg_e2v": {
          "from": "nod_noticeSent",
          "to": "nod_notifyEnd"
        }
      }
    },
    "cnv_offloadNoShows": {
      "kind": "flow",
      "name": "Offload the no-shows' bags",
      "nodes": {
        "nod_eachBag": {
          "kind": "forEach",
          "name": "each bag",
          "items": {
            "var": "vars.bags"
          },
          "as": "bag",
          "inner": {
            "canvas": "cnv_offloadOneBag"
          }
        },
        "nod_listBags": {
          "kind": "call",
          "name": "find their bags",
          "endpoint": "ept_findBags"
        },
        "nod_offloadEnd": {
          "kind": "end"
        },
        "nod_offloadStart": {
          "kind": "start"
        },
        "nod_offloaded": {
          "kind": "emit",
          "name": "bags offloaded",
          "event": "evt_bagsOffloaded"
        }
      },
      "edges": {
        "edg_e4n": {
          "from": "nod_offloadStart",
          "to": "nod_listBags"
        },
        "edg_e4o": {
          "from": "nod_listBags",
          "to": "nod_eachBag"
        },
        "edg_e4p": {
          "from": "nod_eachBag",
          "to": "nod_offloaded"
        },
        "edg_e4q": {
          "from": "nod_offloaded",
          "to": "nod_offloadEnd"
        }
      }
    },
    "cnv_offloadOneBag": {
      "kind": "flow",
      "name": "Offload one bag",
      "nodes": {
        "nod_bagOutEnd": {
          "kind": "end"
        },
        "nod_bagOutStart": {
          "kind": "start"
        },
        "nod_findInHold": {
          "kind": "call",
          "name": "find it in the hold",
          "party": "pty_groundHandler"
        }
      },
      "edges": {
        "edg_e4r": {
          "from": "nod_bagOutStart",
          "to": "nod_findInHold"
        },
        "edg_e4s": {
          "from": "nod_findInHold",
          "to": "nod_bagOutEnd"
        }
      }
    },
    "cnv_parkingStay": {
      "kind": "machine",
      "name": "Parking stay",
      "subject": "stay.status",
      "nodes": {
        "nod_entered": {
          "kind": "state",
          "name": "entered",
          "category": "waiting"
        },
        "nod_exited": {
          "kind": "state",
          "name": "exited",
          "outcome": "success",
          "terminal": true
        },
        "nod_overstay": {
          "kind": "state",
          "name": "overstayed",
          "category": "hold"
        },
        "nod_paid": {
          "kind": "state",
          "name": "paid",
          "category": "waiting"
        },
        "nod_stayStart": {
          "kind": "initial"
        }
      },
      "edges": {
        "edg_e1b9": {
          "from": "nod_stayStart",
          "to": "nod_entered"
        },
        "edg_e1ba": {
          "from": "nod_entered",
          "to": "nod_paid",
          "on": [
            "evt_stayPaid"
          ]
        },
        "edg_e1bb": {
          "from": "nod_paid",
          "to": "nod_exited",
          "on": [
            "evt_stayExited"
          ]
        },
        "edg_e1bc": {
          "from": "nod_paid",
          "to": "nod_overstay",
          "after": "tmr_graceToLeave"
        },
        "edg_e1bd": {
          "from": "nod_overstay",
          "to": "nod_paid",
          "on": [
            "evt_stayPaid"
          ]
        }
      }
    },
    "cnv_passengerJourney": {
      "kind": "machine",
      "name": "Passenger journey",
      "caption": "Where a departing passenger is, as the airport knows it — never who they are.",
      "subject": "journey.stage",
      "transitions": "partial",
      "nodes": {
        "nod_airside": {
          "kind": "state",
          "name": "airside",
          "category": "waiting",
          "summary": "shops · lounges · gates"
        },
        "nod_atGate": {
          "kind": "state",
          "name": "at the gate",
          "category": "waiting"
        },
        "nod_bagDropped": {
          "kind": "state",
          "name": "bag dropped",
          "category": "waiting"
        },
        "nod_booked": {
          "kind": "state",
          "name": "booked",
          "category": "waiting"
        },
        "nod_borderPassed": {
          "kind": "state",
          "name": "border passed",
          "category": "waiting"
        },
        "nod_checkedIn": {
          "kind": "state",
          "name": "checked in",
          "category": "waiting"
        },
        "nod_deniedBoarding": {
          "kind": "state",
          "name": "denied boarding",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_international": {
          "kind": "choice",
          "name": "leaving the Schengen area?"
        },
        "nod_journeyPassenger": {
          "kind": "participant",
          "party": "pty_passenger"
        },
        "nod_journeyStart": {
          "kind": "initial"
        },
        "nod_noShow": {
          "kind": "state",
          "name": "no-show",
          "outcome": "failure",
          "terminal": true
        },
        "nod_onBoard": {
          "kind": "state",
          "name": "on board",
          "outcome": "success",
          "terminal": true
        },
        "nod_screened": {
          "kind": "state",
          "name": "screened",
          "category": "waiting"
        }
      },
      "edges": {
        "edg_e1aw": {
          "from": "nod_journeyStart",
          "to": "nod_booked"
        },
        "edg_e1ax": {
          "from": "nod_booked",
          "to": "nod_checkedIn",
          "on": [
            "evt_passengerCheckedIn"
          ],
          "intent": "happy"
        },
        "edg_e1ay": {
          "from": "nod_checkedIn",
          "to": "nod_bagDropped",
          "on": [
            "evt_bagDropped"
          ]
        },
        "edg_e1az": {
          "from": "nod_checkedIn",
          "to": "nod_screened",
          "on": [
            "evt_passengerScreened"
          ],
          "label": "hand luggage only"
        },
        "edg_e1b0": {
          "from": "nod_bagDropped",
          "to": "nod_screened",
          "on": [
            "evt_passengerScreened"
          ],
          "intent": "happy"
        },
        "edg_e1b1": {
          "from": "nod_screened",
          "to": "nod_international",
          "always": true
        },
        "edg_e1b2": {
          "from": "nod_international",
          "to": "nod_borderPassed",
          "guard": {
            "text": "the destination is outside the Schengen area"
          }
        },
        "edg_e1b3": {
          "from": "nod_international",
          "to": "nod_airside",
          "else": true,
          "intent": "happy"
        },
        "edg_e1b4": {
          "from": "nod_borderPassed",
          "to": "nod_airside",
          "on": [
            "evt_borderCleared"
          ]
        },
        "edg_e1b5": {
          "from": "nod_airside",
          "to": "nod_atGate",
          "on": [
            "evt_passengerAtGate"
          ],
          "intent": "happy"
        },
        "edg_e1b6": {
          "from": "nod_atGate",
          "to": "nod_onBoard",
          "on": [
            "evt_passengerBoarded"
          ],
          "intent": "happy"
        },
        "edg_e1b7": {
          "from": "nod_atGate",
          "to": "nod_deniedBoarding",
          "on": [
            "evt_boardingDenied"
          ],
          "by": "pty_airline",
          "intent": "failure"
        },
        "edg_e1b8": {
          "from": "nod_airside",
          "to": "nod_noShow",
          "on": [
            "evt_gateClosed"
          ],
          "intent": "failure"
        }
      }
    },
