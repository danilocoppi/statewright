        "target": "nod_aodb",
        "tone": "info"
      },
      "nte_beltNote": {
        "text": "Terminal D's last two screening machines are proposed: until then its bags take C's.",
        "canvas": "cnv_beltNetwork",
        "target": "nod_edsD5",
        "tone": "warning"
      },
      "nte_wayfindingNote": {
        "text": "Wayfinding still reads the old FIDS feed; it is the last legacy consumer.",
        "canvas": "cnv_airportOperations",
        "target": "nod_wayfinding",
        "tone": "warning"
      }
    },
