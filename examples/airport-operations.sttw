    "cnv_bagLifecycle": {
      "kind": "machine",
      "name": "Bag lifecycle",
      "caption": "IATA Resolution 753: every bag is tracked at acceptance, loading, transfer and arrival.",
      "subject": "bag.status",
      "transitions": "complete",
      "nodes": {
        "nod_accepted": {
          "kind": "state",
          "name": "accepted",
          "category": "waiting"
        },
        "nod_bagHandler": {
          "kind": "participant",
          "party": "pty_groundHandler"
        },
        "nod_bagPassenger": {
          "kind": "participant",
          "party": "pty_passenger"
        },
        "nod_bagStart": {
          "kind": "initial"
        },
        "nod_dropBag": {
          "kind": "entry",
          "name": "POST /bags",
          "via": "ept_acceptABag",
          "by": "pty_passenger"
        },
        "nod_flown": {
          "kind": "state",
          "name": "flown",
          "outcome": "success",
          "terminal": true
        },
        "nod_inSystem": {
          "kind": "state",
          "name": "in the system",
          "category": "processing"
        },
        "nod_levelThree": {
          "kind": "state",
          "name": "level 3 review",
          "category": "hold"
        },
        "nod_loaded": {
          "kind": "state",
          "name": "loaded",
          "category": "waiting"
        },
        "nod_madeUp": {
          "kind": "state",
          "name": "in a container",
          "category": "waiting"
        },
        "nod_mishandled": {
          "kind": "state",
          "name": "mishandled",
          "outcome": "failure",
          "terminal": true
        },
        "nod_offloadedBag": {
          "kind": "state",
          "name": "offloaded",
          "category": "hold"
        },
        "nod_rejectedBag": {
          "kind": "state",
          "name": "rejected",
          "outcome": "failure",
          "terminal": true
        },
        "nod_screenResult": {
          "kind": "choice",
          "name": "cleared?"
        },
        "nod_screening": {
          "kind": "state",
          "name": "screening",
          "category": "processing"
        },
        "nod_sorting": {
          "kind": "state",
          "name": "sorting",
          "category": "processing"
        },
        "nod_stored": {
          "kind": "state",
          "name": "in the early bag store",
          "category": "waiting"
        },
        "nod_unread": {
          "kind": "state",
          "name": "manual encoding",
          "category": "hold"
        }
      },
      "edges": {
        "edg_emf": {
          "from": "nod_bagStart",
          "to": "nod_accepted"
        },
        "edg_emg": {
          "from": "nod_dropBag",
          "to": "nod_accepted",
          "actions": [
            {
              "emit": "evt_bagSourceMessage"
            }
          ]
        },
        "edg_emh": {
          "from": "nod_accepted",
          "to": "nod_inSystem",
          "on": [
            "evt_bagInducted"
          ],
          "intent": "happy"
        },
        "edg_emi": {
          "from": "nod_inSystem",
          "to": "nod_screening",
          "on": [
            "evt_bagScreened"
          ],
          "intent": "happy"
        },
        "edg_emj": {
          "from": "nod_screening",
          "to": "nod_screenResult",
          "always": true
        },
        "edg_emk": {
          "from": "nod_screenResult",
          "to": "nod_sorting",
          "guard": {
            "guard": "grd_cleared"
          },
          "intent": "happy"
        },
        "edg_eml": {
          "from": "nod_screenResult",
          "to": "nod_levelThree",
          "else": true
        },
        "edg_emm": {
          "from": "nod_levelThree",
          "to": "nod_sorting",
          "on": [
            "evt_bagCleared"
          ],
          "by": "pty_security"
        },
        "edg_emn": {
          "from": "nod_levelThree",
          "to": "nod_rejectedBag",
          "on": [
            "evt_bagRejected"
          ],
          "by": "pty_security",
          "intent": "failure"
        },
        "edg_emo": {
          "from": "nod_sorting",
          "to": "nod_madeUp",
          "on": [
            "evt_bagSorted"
          ],
          "intent": "happy"
        },
        "edg_emp": {
          "from": "nod_sorting",
          "to": "nod_stored",
          "on": [
            "evt_bagEarly"
          ]
        },
        "edg_emq": {
          "from": "nod_stored",
          "to": "nod_sorting",
          "on": [
            "evt_bagReleased"
          ]
        },
        "edg_emr": {
          "from": "nod_sorting",
          "to": "nod_unread",
          "on": [
            "evt_bagNoRead"
          ]
        },
        "edg_ems": {
          "from": "nod_unread",
          "to": "nod_sorting",
          "on": [
            "evt_bagEncoded"
          ],
          "by": "pty_baggageOps"
        },
        "edg_emt": {
          "from": "nod_madeUp",
          "to": "nod_loaded",
          "on": [
            "evt_bagLoaded"
          ],
          "by": "pty_groundHandler",
          "intent": "happy"
        },
        "edg_emu": {
          "from": "nod_loaded",
          "to": "nod_flown",
          "on": [
            "evt_aircraftAirborne"
          ],
          "intent": "happy"
        },
        "edg_emv": {
          "from": "nod_loaded",
          "to": "nod_offloadedBag",
          "on": [
            "evt_bagsOffloaded"
          ],
          "by": "pty_groundHandler"
        },
        "edg_emw": {
          "from": "nod_offloadedBag",
          "to": "nod_sorting",
          "on": [
            "evt_bagReflighted"
          ]
        },
        "edg_emx": {
          "from": "nod_offloadedBag",
          "to": "nod_mishandled",
          "after": "tmr_rushWindow",
          "intent": "failure"
        }
      }
    },
