    "scenarios": {
      "scn_aBagFromTheDropToTheHold": {
        "name": "A bag from the drop to the hold",
        "description": "Cleared by the machine, sorted, built into a container, flown.",
        "canvas": "cnv_bagLifecycle",
        "start": {
          "at": "2026-10-01T06:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_bagInducted"
            },
            "reached": {
              "active": [
                "nod_inSystem"
              ]
            }
          },
          {
            "do": {
              "event": "evt_bagScreened"
            },
            "answers": [
              {
                "kind": "choice",
                "at": "nod_screenResult",
                "value": "edg_eml"
              }
            ],
            "reached": {
              "active": [
                "nod_levelThree"
              ]
            }
          },
          {
            "do": {
              "event": "evt_bagSorted"
            },
            "reached": {
              "active": [
                "nod_levelThree"
              ]
            }
          },
          {
            "do": {
              "event": "evt_bagLoaded"
            },
            "reached": {
              "active": [
                "nod_levelThree"
              ]
            }
          },
          {
            "do": {
              "event": "evt_aircraftAirborne"
            },
            "reached": {
              "active": [
                "nod_levelThree"
              ]
            }
          }
        ]
      },
      "scn_aDelayThenANewSlot": {
        "name": "A delay, then a new slot",
        "description": "A delay while check-in is open; the network manager revises the slot and the flight goes on.",
        "canvas": "cnv_flightLifecycle",
        "start": {
          "at": "2026-10-01T06:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_ctotIssued"
            },
            "reached": {
              "active": [
                "nod_slotConfirmed"
              ]
            }
          },
          {
            "do": {
              "event": "evt_standAllocated"
            },
            "reached": {
              "active": [
                "nod_standAllocated"
              ]
            }
          },
          {
            "do": {
              "wait": "next"
            },
            "reached": {
              "active": [
                "nod_checkInOpen"
              ]
            }
          },
          {
            "do": {
              "event": "evt_flightDelayed"
            },
            "reached": {
              "active": [
                "nod_delayedFlight"
              ]
            }
          },
          {
            "do": {
              "event": "evt_ctotRevised"
            },
            "reached": {
              "active": [
                "nod_slotConfirmed"
              ]
            }
          }
        ]
      },
      "scn_aDepartureOnTime": {
        "name": "A departure on time",
        "description": "From the schedule to the hand-off, no ice, no delay.",
        "canvas": "cnv_flightLifecycle",
        "start": {
          "at": "2026-10-01T06:00:00Z"
        },
        "steps": [
          {
            "do": {
