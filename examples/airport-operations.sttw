        },
        "edg_e1d4": {
          "from": "nod_callHospitals",
          "to": "nod_calledOut"
        },
        "edg_e1d5": {
          "from": "nod_callPolice",
          "to": "nod_calledOut"
        },
        "edg_e1d6": {
