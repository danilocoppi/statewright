          "category": "processing"
        },
        "nod_handedOff": {
          "kind": "state",
          "name": "handed off",
          "outcome": "success",
          "terminal": true
        },
        "nod_holdingPattern": {
          "kind": "state",
          "name": "holding",
          "category": "hold"
        },
        "nod_initialClimb": {
          "kind": "state",
          "name": "initial climb",
          "category": "processing"
        }
      },
      "edges": {
        "edg_e37": {
          "from": "nod_climbStart",
          "to": "nod_initialClimb"
        },
        "edg_e38": {
          "from": "nod_initialClimb",
          "to": "nod_departureRoute",
          "on": [
            "evt_routeJoined"
          ],
          "intent": "happy"
        },
        "edg_e39": {
          "from": "nod_departureRoute",
          "to": "nod_handedOff",
          "on": [
            "evt_handoffAccepted"
          ],
          "by": "pty_atc",
