          "party": "pty_aodb",
          "summary": "≈1,300 movements a day",
          "inner": {
            "canvas": "cnv_flightLifecycle"
          }
        },
        "nod_fuelService": {
          "kind": "service",
          "name": "Into-plane fuelling",
          "party": "pty_fuelSupplier",
