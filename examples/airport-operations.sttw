    "cnv_alarmResolution": {
      "kind": "machine",
      "name": "Alarm resolution",
      "subject": "lane.alarm",
      "nodes": {
        "nod_alarmCleared": {
          "kind": "state",
          "name": "cleared",
          "outcome": "success",
          "terminal": true
        },
        "nod_alarmStart": {
          "kind": "initial"
        },
        "nod_explosiveTrace": {
          "kind": "state",
          "name": "trace detection",
          "category": "processing"
        },
        "nod_policeCalled": {
          "kind": "state",
          "name": "police called",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_searching": {
          "kind": "state",
          "name": "hand search",
          "category": "processing"
        },
        "nod_trayHeld": {
          "kind": "state",
          "name": "tray held",
          "category": "hold"
        }
      },
      "edges": {
        "edg_e1a9": {
          "from": "nod_alarmStart",
          "to": "nod_trayHeld"
        },
        "edg_e1aa": {
          "from": "nod_trayHeld",
          "to": "nod_searching",
          "on": [
            "evt_searchStarted"
          ],
          "by": "pty_security"
        },
        "edg_e1ab": {
          "from": "nod_searching",
          "to": "nod_alarmCleared",
          "on": [
            "evt_searchClear"
          ],
          "intent": "happy"
        },
        "edg_e1ac": {
          "from": "nod_searching",
          "to": "nod_explosiveTrace",
          "on": [
            "evt_searchSuspicious"
          ]
        },
        "edg_e1ad": {
          "from": "nod_explosiveTrace",
          "to": "nod_alarmCleared",
          "on": [
            "evt_traceNegative"
          ]
        },
        "edg_e1ae": {
          "from": "nod_explosiveTrace",
          "to": "nod_policeCalled",
          "on": [
            "evt_tracePositive"
          ],
          "intent": "failure"
        }
      }
    },
    "cnv_aodbIntegrations": {
      "kind": "system",
      "name": "Operations database",
      "caption": "One record per flight; adapters translate each partner's messages into it.",
      "nodes": {
        "nod_acdmAdapter": {
          "kind": "service",
          "name": "A-CDM adapter",
          "summary": "DPI · to the network manager"
        },
        "nod_aodbBus": {
          "kind": "queue",
          "name": "Integration bus",
          "summary": "AMQP"
        },
        "nod_billingAdapter": {
          "kind": "service",
          "name": "Billing export",
          "summary": "monthly"
        },
        "nod_fidsAdapter": {
          "kind": "service",
          "name": "Displays feed",
          "summary": "pushed · 2 s"
        },
        "nod_flightRecord": {
          "kind": "store",
          "name": "Flight record",
          "summary": "PostgreSQL · 7 years"
        },
        "nod_legacyFeed": {
          "kind": "service",
          "name": "Old displays feed",
          "summary": "FTP · polled every 60 s",
          "provenance": "legacy",
          "confidence": "low"
        },
        "nod_metAdapter": {
          "kind": "service",
          "name": "Weather adapter",
          "summary": "METAR · TAF"
        },
        "nod_mvtAdapter": {
          "kind": "service",
          "name": "Movement adapter",
          "summary": "IATA MVT · LDM"
        },
        "nod_radarAdapter": {
          "kind": "service",
          "name": "Surveillance adapter",
          "summary": "ADS-B · A-SMGCS"
        },
        "nod_ssimAdapter": {
          "kind": "service",
          "name": "Schedule adapter",
          "summary": "SSIM · seasonal"
        }
      },
      "edges": {
        "edg_e1d8": {
          "from": "nod_aodbBus",
          "to": "nod_flightRecord",
          "kind": "data"
        },
        "edg_e1d9": {
          "from": "nod_ssimAdapter",
          "to": "nod_aodbBus",
          "kind": "event"
        },
        "edg_e1da": {
          "from": "nod_mvtAdapter",
          "to": "nod_aodbBus",
          "kind": "event"
        },
        "edg_e1db": {
          "from": "nod_acdmAdapter",
          "to": "nod_aodbBus",
          "kind": "event"
        },
        "edg_e1dc": {
          "from": "nod_radarAdapter",
          "to": "nod_aodbBus",
          "kind": "event"
        },
        "edg_e1dd": {
          "from": "nod_metAdapter",
          "to": "nod_aodbBus",
          "kind": "event"
        },
        "edg_e1de": {
          "from": "nod_billingAdapter",
