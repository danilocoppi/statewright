    "cnv_turnaroundMilestones": {
      "kind": "machine",
      "name": "Turnaround milestones",
      "caption": "Each region is one team's work on the stand; the turnaround ends when all six are done.",
      "subject": "turnaround.milestones",
      "regions": {
        "rgn_bagsRegion": {
          "name": "Bags and cargo"
        },
        "rgn_cateringRegion": {
          "name": "Catering"
        },
        "rgn_cleaningRegion": {
          "name": "Cleaning"
        },
        "rgn_fuelRegion": {
          "name": "Fuel"
        },
        "rgn_groundRegion": {
          "name": "Ground power and water"
        },
        "rgn_passengersRegion": {
          "name": "Passengers"
        }
      },
      "transitions": "complete",
      "nodes": {
        "nod_bagsRegionHoldsClosed": {
          "kind": "state",
          "name": "holds closed",
          "region": "rgn_bagsRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_bagsRegionHoldsEmpty": {
          "kind": "state",
          "name": "holds empty",
          "region": "rgn_bagsRegion",
          "category": "processing"
        },
        "nod_bagsRegionLoadingBags": {
          "kind": "state",
          "name": "loading",
          "region": "rgn_bagsRegion",
          "category": "processing"
        },
        "nod_bagsRegionOffloadingBags": {
          "kind": "state",
          "name": "offloading",
          "region": "rgn_bagsRegion",
          "category": "processing"
        },
        "nod_bagsRegionStart": {
          "kind": "initial",
          "region": "rgn_bagsRegion"
        },
        "nod_cateringRegionCatered": {
          "kind": "state",
          "name": "catered",
          "region": "rgn_cateringRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_cateringRegionCateringArrived": {
          "kind": "state",
          "name": "truck at the door",
          "region": "rgn_cateringRegion",
          "category": "processing"
        },
        "nod_cateringRegionStart": {
          "kind": "initial",
          "region": "rgn_cateringRegion"
        },
        "nod_cleaningRegionCleaned": {
          "kind": "state",
          "name": "cleaned",
          "region": "rgn_cleaningRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_cleaningRegionCleaningCabin": {
          "kind": "state",
          "name": "cleaning",
          "region": "rgn_cleaningRegion",
          "category": "processing"
        },
        "nod_cleaningRegionStart": {
          "kind": "initial",
          "region": "rgn_cleaningRegion"
        },
        "nod_fuelRegionAwaitingFuel": {
          "kind": "state",
          "name": "awaiting the truck",
          "region": "rgn_fuelRegion",
          "category": "processing"
        },
        "nod_fuelRegionFuelled": {
          "kind": "state",
          "name": "fuelled",
          "region": "rgn_fuelRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_fuelRegionFuelling": {
          "kind": "state",
          "name": "fuelling",
          "region": "rgn_fuelRegion",
          "category": "processing"
        },
        "nod_fuelRegionStart": {
          "kind": "initial",
          "region": "rgn_fuelRegion"
        },
        "nod_groundRegionGpuConnected": {
          "kind": "state",
          "name": "power connected",
          "region": "rgn_groundRegion",
          "category": "processing"
        },
        "nod_groundRegionGpuDisconnected": {
          "kind": "state",
          "name": "power disconnected",
          "region": "rgn_groundRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_groundRegionStart": {
          "kind": "initial",
          "region": "rgn_groundRegion"
        },
        "nod_groundRegionWaterServiced": {
          "kind": "state",
          "name": "water serviced",
          "region": "rgn_groundRegion",
          "category": "processing"
        },
        "nod_passengersRegionCabinEmpty": {
          "kind": "state",
          "name": "cabin empty",
          "region": "rgn_passengersRegion",
          "category": "processing"
        },
        "nod_passengersRegionCabinReady": {
          "kind": "state",
          "name": "cabin ready",
          "region": "rgn_passengersRegion",
          "outcome": "success",
          "terminal": true
        },
        "nod_passengersRegionDeboarding": {
          "kind": "state",
          "name": "deboarding",
          "region": "rgn_passengersRegion",
          "category": "processing"
        },
        "nod_passengersRegionStart": {
          "kind": "initial",
          "region": "rgn_passengersRegion"
        }
      },
      "edges": {
        "edg_e3c": {
          "from": "nod_passengersRegionStart",
          "to": "nod_passengersRegionDeboarding",
          "actions": [
            {
              "action": "act_runTheTurnaround"
            }
          ]
        },
        "edg_e3d": {
          "from": "nod_passengersRegionDeboarding",
          "to": "nod_passengersRegionCabinEmpty",
          "on": [
            "evt_deboardingCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3e": {
          "from": "nod_passengersRegionCabinEmpty",
          "to": "nod_passengersRegionCabinReady",
          "on": [
            "evt_cabinReady"
          ],
          "intent": "happy"
        },
        "edg_e3f": {
          "from": "nod_bagsRegionStart",
          "to": "nod_bagsRegionOffloadingBags"
        },
        "edg_e3g": {
          "from": "nod_bagsRegionOffloadingBags",
          "to": "nod_bagsRegionHoldsEmpty",
          "on": [
            "evt_offloadCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3h": {
          "from": "nod_bagsRegionHoldsEmpty",
          "to": "nod_bagsRegionLoadingBags",
          "on": [
            "evt_loadingStarted"
          ],
          "intent": "happy"
        },
        "edg_e3i": {
          "from": "nod_bagsRegionLoadingBags",
          "to": "nod_bagsRegionHoldsClosed",
          "on": [
            "evt_holdsClosed"
          ],
          "intent": "happy"
        },
        "edg_e3j": {
          "from": "nod_fuelRegionStart",
          "to": "nod_fuelRegionAwaitingFuel"
        },
        "edg_e3k": {
          "from": "nod_fuelRegionAwaitingFuel",
          "to": "nod_fuelRegionFuelling",
          "on": [
            "evt_fuelStarted"
          ],
          "intent": "happy"
        },
        "edg_e3l": {
          "from": "nod_fuelRegionFuelling",
          "to": "nod_fuelRegionFuelled",
          "on": [
            "evt_fuelCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3m": {
          "from": "nod_cateringRegionStart",
          "to": "nod_cateringRegionCateringArrived"
        },
        "edg_e3n": {
          "from": "nod_cateringRegionCateringArrived",
          "to": "nod_cateringRegionCatered",
          "on": [
            "evt_cateringCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3o": {
          "from": "nod_cleaningRegionStart",
          "to": "nod_cleaningRegionCleaningCabin"
        },
        "edg_e3p": {
          "from": "nod_cleaningRegionCleaningCabin",
          "to": "nod_cleaningRegionCleaned",
          "on": [
            "evt_cleaningCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3q": {
          "from": "nod_groundRegionStart",
          "to": "nod_groundRegionGpuConnected"
        },
        "edg_e3r": {
          "from": "nod_groundRegionGpuConnected",
          "to": "nod_groundRegionWaterServiced",
          "on": [
            "evt_waterCompleted"
          ],
          "intent": "happy"
        },
        "edg_e3s": {
          "from": "nod_groundRegionWaterServiced",
          "to": "nod_groundRegionGpuDisconnected",
          "on": [
            "evt_gpuDisconnected"
          ],
          "intent": "happy"
        }
      }
    },
    "cnv_turnaroundProcedure": {
      "kind": "flow",
      "name": "Turnaround procedure",
      "nodes": {
        "nod_onBlockChocks": {
          "kind": "assign",
          "name": "chocks and cones",
          "set": {
            "vars.safe": true
          }
        },
        "nod_procCater": {
          "kind": "wait",
          "name": "catered",
          "on": [
            "evt_cateringCompleted"
          ]
        },
        "nod_procClean": {
          "kind": "wait",
          "name": "cleaned",
          "on": [
            "evt_cleaningCompleted"
          ]
        },
        "nod_procDeboard": {
          "kind": "wait",
          "name": "deboarded",
          "on": [
            "evt_deboardingCompleted"
          ]
        },
        "nod_procDone": {
          "kind": "emit",
          "name": "turnaround completed",
          "event": "evt_turnaroundCompleted"
        },
        "nod_procEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_procFuel": {
          "kind": "wait",
          "name": "fuelled",
          "on": [
            "evt_fuelCompleted"
          ]
        },
        "nod_procHandler": {
          "kind": "participant",
          "party": "pty_groundHandler"
        },
        "nod_procLoad": {
          "kind": "wait",
          "name": "holds closed",
          "on": [
            "evt_holdsClosed"
          ]
        },
        "nod_procOffload": {
          "kind": "wait",
          "name": "holds empty",
          "on": [
            "evt_offloadCompleted"
          ]
        },
        "nod_procStart": {
          "kind": "start"
        },
        "nod_teams": {
          "kind": "parallel",
          "name": "all teams"
        },
        "nod_teamsDone": {
          "kind": "join",
          "name": "all done"
        }
      },
      "edges": {
        "edg_e1dh": {
          "from": "nod_procStart",
          "to": "nod_onBlockChocks"
        },
        "edg_e1di": {
          "from": "nod_onBlockChocks",
          "to": "nod_teams"
        },
        "edg_e1dj": {
          "from": "nod_teams",
          "to": "nod_procDeboard"
        },
        "edg_e1dk": {
          "from": "nod_teams",
          "to": "nod_procCater"
        },
        "edg_e1dl": {
          "from": "nod_teams",
          "to": "nod_procOffload"
        },
        "edg_e1dm": {
          "from": "nod_teams",
          "to": "nod_procFuel"
        },
        "edg_e1dn": {
          "from": "nod_procDeboard",
          "to": "nod_procClean"
        },
        "edg_e1do": {
          "from": "nod_procOffload",
          "to": "nod_procLoad"
        },
        "edg_e1dp": {
          "from": "nod_procClean",
          "to": "nod_teamsDone"
        },
        "edg_e1dq": {
          "from": "nod_procCater",
          "to": "nod_teamsDone"
        },
        "edg_e1dr": {
          "from": "nod_procLoad",
          "to": "nod_teamsDone"
        },
        "edg_e1ds": {
          "from": "nod_procFuel",
          "to": "nod_teamsDone"
        },
        "edg_e1dt": {
          "from": "nod_teamsDone",
          "to": "nod_procDone"
        },
        "edg_e1du": {
          "from": "nod_procDone",
          "to": "nod_procEnd"
        }
      }
    },
    "cnv_workOrder": {
      "kind": "machine",
      "name": "Work order",
      "subject": "workOrder.status",
      "transitions": "complete",
      "nodes": {
        "nod_awaitingParts": {
          "kind": "state",
          "name": "awaiting parts",
          "category": "hold"
        },
        "nod_inProgress": {
          "kind": "state",
          "name": "in progress",
          "category": "processing"
        },
        "nod_raised": {
          "kind": "state",
          "name": "raised",
          "category": "waiting"
        },
        "nod_triaged": {
          "kind": "state",
          "name": "triaged",
          "category": "waiting"
        },
        "nod_workDone": {
          "kind": "state",
          "name": "done",
          "outcome": "success",
          "terminal": true
        },
        "nod_workRejected": {
          "kind": "state",
          "name": "rejected",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_workStart": {
          "kind": "initial"
        }
      },
      "edges": {
        "edg_e1cm": {
          "from": "nod_workStart",
          "to": "nod_raised"
        },
        "edg_e1cn": {
          "from": "nod_raised",
          "to": "nod_triaged",
          "on": [
            "evt_workTriaged"
          ],
          "by": "pty_maintenance",
          "intent": "happy"
        },
        "edg_e1co": {
          "from": "nod_raised",
          "to": "nod_workRejected",
          "on": [
            "evt_workRejected"
          ],
          "by": "pty_maintenance"
        },
        "edg_e1cp": {
          "from": "nod_triaged",
          "to": "nod_inProgress",
          "on": [
            "evt_workStarted"
          ],
          "intent": "happy"
        },
        "edg_e1cq": {
          "from": "nod_inProgress",
          "to": "nod_awaitingParts",
          "on": [
            "evt_workPartsNeeded"
          ]
        },
        "edg_e1cr": {
          "from": "nod_awaitingParts",
          "to": "nod_inProgress",
          "on": [
            "evt_workPartsArrived"
          ]
        },
        "edg_e1cs": {
          "from": "nod_inProgress",
          "to": "nod_workDone",
          "on": [
            "evt_workCompleted"
          ],
          "actions": [
            {
              "emit": "evt_standReturned"
            }
          ],
          "intent": "happy"
        }
      }
    }
  },
  "annotations": {
    "findings": {
      "fnd_legacyFeed": {
        "code": "L1",
        "title": "Wayfinding still polls the old displays feed",
        "severity": "medium",
        "description": "The FTP feed is polled every 60 s; gate changes reach the signs a minute late.",
        "targets": [
          "nod_legacyFeed",
          "nod_wayfinding"
        ],
        "source": "audit"
      },
      "fnd_noShowWindow": {
        "code": "B2",
        "title": "No-shows' bags wait two hours before they count as mishandled",
        "severity": "low",
        "description": "A rush tag after two hours misses the next bank of departures.",
        "targets": [
          "nod_offloadedBag"
        ],
        "source": "audit"
      }
    },
    "notes": {
      "nte_aodbNote": {
