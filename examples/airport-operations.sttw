    "actions": {
      "act_chargeTheMovement": {
        "name": "Charge the movement",
        "party": "pty_paymentProvider"
      },
      "act_notifyPassengers": {
        "name": "Notify passengers",
        "emits": [
          "evt_passengerNotified"
        ],
        "party": "pty_aodb",
        "inner": {
          "canvas": "cnv_notifyPassengers"
        },
        "description": "Push, SMS and e-mail to everyone booked on the flight."
      },
      "act_publishToDisplays": {
        "name": "Publish to displays",
        "party": "pty_aodb",
        "description": "Pushes the flight to every screen."
      },
      "act_releaseTheStand": {
        "name": "Release the stand",
        "party": "pty_apoc"
      },
      "act_requestDeIcing": {
        "name": "Request de-icing",
