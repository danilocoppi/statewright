          "evt_deicingRequested"
        ],
        "party": "pty_groundHandler"
      },
      "act_runTheTurnaround": {
        "name": "Run the turnaround",
        "emits": [
          "evt_turnaroundCompleted"
        ],
        "party": "pty_groundHandler",
        "inner": {
          "canvas": "cnv_turnaroundProcedure"
        },
        "description": "Everything that happens to an aircraft between on-block and off-block."
      }
