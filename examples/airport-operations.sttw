    "cnv_airportOperations": {
      "kind": "system",
      "name": "Airport operations",
      "title": "Airport operations",
      "caption": "Four terminals, two runways, 120 stands. The operations database is the source of truth for every flight; everything else listens to it or feeds it.",
      "nodes": {
        "nod_airTrafficControl": {
          "kind": "external",
          "name": "Air traffic control",
          "party": "pty_atc",
          "summary": "tower · ground · approach"
        },
        "nod_airfield": {
          "kind": "service",
          "name": "Airfield guidance",
          "party": "pty_apoc",
          "summary": "A-SMGCS · 2 runways · 64 taxiways",
          "inner": {
            "canvas": "cnv_airfieldSurface"
          }
        },
        "nod_airlineAgent": {
          "kind": "actor",
          "name": "Airline agent",
          "party": "pty_airline"
        },
        "nod_airlineDcs": {
          "kind": "external",
          "name": "Airline DCS",
          "party": "pty_dcs",
          "summary": "check-in · boarding lists · load"
        },
        "nod_airlineOpsControl": {
          "kind": "external",
          "name": "Airline ops control",
          "party": "pty_airline"
        },
        "nod_alertsQueue": {
          "kind": "queue",
          "name": "Alerts",
          "summary": "priority ordered"
        },
        "nod_aodb": {
          "kind": "service",
          "name": "Operations database",
          "party": "pty_aodb",
          "summary": "AODB · the flight of record",
          "inner": {
            "canvas": "cnv_aodbIntegrations"
          },
          "evidence": [
            {
              "kind": "doc",
              "url": "https://www.eurocontrol.int/concept/airport-collaborative-decision-making"
            }
          ]
        },
        "nod_apocDuty": {
          "kind": "actor",
          "name": "Duty manager",
          "party": "pty_apoc",
          "summary": "APOC · 24/7"
        },
        "nod_bagMessages": {
          "kind": "queue",
          "name": "Bag messages",
          "summary": "BSM · BPM · BTM (IATA RP 1745)"
        },
        "nod_baggageHandling": {
          "kind": "service",
          "name": "Baggage handling",
          "party": "pty_bhs",
          "summary": "68 km of belts · 4 sorters · 48 EDS",
          "inner": {
            "canvas": "cnv_beltNetwork"
          }
        },
        "nod_bags": {
          "kind": "store",
          "name": "Bags",
          "party": "pty_bhs",
          "summary": "≈95,000 a day at peak",
          "inner": {
            "canvas": "cnv_bagLifecycle"
          }
        },
        "nod_billing": {
          "kind": "service",
          "name": "Aeronautical billing",
          "summary": "landing · parking · passenger fees",
          "inner": {
            "canvas": "cnv_monthlyBilling"
          }
        },
        "nod_boarding": {
          "kind": "service",
          "name": "Boarding",
          "party": "pty_groundHandler",
          "inner": {
            "canvas": "cnv_boardingProcedure"
          }
        },
        "nod_borderControl": {
          "kind": "service",
          "name": "Border control",
          "party": "pty_borderPolice",
          "summary": "e-gates · officers",
          "inner": {
            "canvas": "cnv_borderCheck"
          }
        },
        "nod_borderPoliceExt": {
          "kind": "external",
          "name": "Border police",
          "party": "pty_borderPolice"
        },
        "nod_cateringCompany": {
          "kind": "external",
          "name": "Catering company",
          "party": "pty_caterer"
        },
        "nod_checkIn": {
          "kind": "service",
          "name": "Check-in and bag drop",
          "party": "pty_groundHandler",
          "inner": {
            "canvas": "cnv_checkInHalls"
          }
        },
        "nod_cleaningService": {
          "kind": "service",
          "name": "Cabin cleaning",
          "party": "pty_cleaning",
          "inner": {
            "canvas": "cnv_cabinCleaning"
          }
        },
        "nod_customsExt": {
          "kind": "external",
          "name": "Customs",
          "party": "pty_customs"
        },
        "nod_deIcing": {
          "kind": "service",
          "name": "De-icing",
          "party": "pty_groundHandler",
          "summary": "6 remote pads",
          "inner": {
            "canvas": "cnv_deIcingProcedure"
          }
        },
        "nod_emergencyResponse": {
          "kind": "service",
          "name": "Emergency response",
          "party": "pty_fireRescue",
          "inner": {
            "canvas": "cnv_emergencyDesk"
          }
