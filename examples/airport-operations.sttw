        "edg_e3b": {
          "from": "nod_holdingPattern",
          "to": "nod_departureRoute",
          "on": [
            "evt_holdReleased"
          ],
          "by": "pty_atc"
        }
      }
    },
    "cnv_deIcingProcedure": {
      "kind": "flow",
      "name": "De-icing",
      "nodes": {
        "nod_conditions": {
          "kind": "switch",
          "name": "conditions?",
          "on": {
            "var": "vars.weather.precipitation"
          }
        },
        "nod_holdover": {
          "kind": "if",
          "name": "holdover time left?",
          "condition": {
            "text": "the fluid's holdover time covers the taxi to the runway"
          }
        },
        "nod_iceAgain": {
          "kind": "end",
          "name": "again",
          "outcome": "failure"
        },
        "nod_iceDone": {
          "kind": "emit",
          "name": "de-icing completed",
          "event": "evt_deicingCompleted"
        },
        "nod_iceEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_iceStart": {
          "kind": "start"
        },
        "nod_leftWing": {
          "kind": "call",
          "name": "spray the left wing",
          "party": "pty_groundHandler"
        },
        "nod_padSlot": {
          "kind": "wait",
          "name": "a pad is free",
          "on": [
            "evt_deicingPadAssigned"
          ]
        },
        "nod_readWeather": {
          "kind": "call",
          "name": "read the weather",
          "endpoint": "ept_weather"
        },
        "nod_rightWing": {
          "kind": "call",
          "name": "spray the right wing",
          "party": "pty_groundHandler"
        },
        "nod_spray": {
          "kind": "parallel",
          "name": "both wings"
        },
        "nod_sprayed": {
          "kind": "join"
        },
        "nod_typeFour": {
          "kind": "assign",
          "name": "type I then IV",
          "set": {
            "vars.fluid": "I+IV"
          }
        },
        "nod_typeOne": {
          "kind": "assign",
          "name": "type I only",
          "set": {
            "vars.fluid": "I"
          }
        }
      },
      "edges": {
        "edg_e4t": {
          "from": "nod_iceStart",
          "to": "nod_readWeather"
        },
        "edg_e4u": {
          "from": "nod_readWeather",
          "to": "nod_conditions"
        },
        "edg_e4v": {
          "from": "nod_conditions",
          "to": "nod_typeOne",
          "kind": "case",
          "case": "frost"
        },
        "edg_e4w": {
          "from": "nod_conditions",
          "to": "nod_typeFour",
          "kind": "case",
          "case": "snow"
        },
        "edg_e4x": {
          "from": "nod_conditions",
          "to": "nod_typeFour",
          "kind": "case",
          "case": "freezingRain"
        },
        "edg_e4y": {
          "from": "nod_conditions",
          "to": "nod_typeOne",
          "kind": "default"
        },
        "edg_e4z": {
          "from": "nod_typeOne",
          "to": "nod_padSlot"
        },
        "edg_e50": {
          "from": "nod_typeFour",
          "to": "nod_padSlot"
        },
        "edg_e51": {
          "from": "nod_padSlot",
          "to": "nod_spray"
        },
        "edg_e52": {
          "from": "nod_spray",
          "to": "nod_leftWing"
        },
        "edg_e53": {
          "from": "nod_spray",
          "to": "nod_rightWing"
        },
        "edg_e54": {
          "from": "nod_leftWing",
          "to": "nod_sprayed"
        },
        "edg_e55": {
          "from": "nod_rightWing",
          "to": "nod_sprayed"
        },
        "edg_e56": {
          "from": "nod_sprayed",
          "to": "nod_holdover"
        },
        "edg_e57": {
          "from": "nod_holdover",
          "to": "nod_iceDone",
          "kind": "true"
        },
        "edg_e58": {
          "from": "nod_holdover",
          "to": "nod_iceAgain",
          "kind": "false"
        },
        "edg_e59": {
          "from": "nod_iceDone",
          "to": "nod_iceEnd"
        }
      }
    },
    "cnv_disruptionDesk": {
      "kind": "mixed",
      "name": "Disruption desk",
      "caption": "A mixed level: a disruption's states, the steps the desk takes, and who it works with.",
      "subject": "disruption.status",
      "nodes": {
        "nod_assessStart": {
          "kind": "start"
        },
        "nod_assessing": {
          "kind": "state",
          "name": "assessing",
          "category": "processing"
        },
        "nod_declareMajor": {
          "kind": "emit",
          "name": "declare a major disruption",
          "event": "evt_disruptionMajor"
        },
        "nod_deskNotifications": {
          "kind": "service",
          "name": "Notifications",
          "party": "pty_aodb"
        },
        "nod_disruptionClosed": {
          "kind": "state",
          "name": "closed",
          "outcome": "success",
          "terminal": true
        },
        "nod_disruptionOpen": {
          "kind": "state",
          "name": "open",
          "category": "waiting"
        },
        "nod_disruptionStart": {
          "kind": "initial"
        },
        "nod_dutyManager": {
          "kind": "actor",
          "name": "Duty manager",
          "party": "pty_apoc"
        },
        "nod_handleLocally": {
          "kind": "emit",
          "name": "handle it at the desk",
          "event": "evt_disruptionLocal"
        },
        "nod_howBad": {
          "kind": "if",
          "condition": {
            "text": "more than 20 flights are affected"
          }
        },
        "nod_mitigating": {
          "kind": "state",
          "name": "mitigating",
          "category": "processing"
        }
      },
      "edges": {
        "edg_e5a": {
          "kind": "transition",
          "from": "nod_disruptionStart",
          "to": "nod_disruptionOpen"
        },
        "edg_e5b": {
          "kind": "transition",
          "from": "nod_disruptionOpen",
          "to": "nod_assessing",
          "on": [
            "evt_disruptionReported"
          ]
        },
        "edg_e5c": {
          "kind": "transition",
          "from": "nod_assessing",
          "to": "nod_mitigating",
          "on": [
            "evt_disruptionMajor"
          ]
        },
        "edg_e5d": {
          "kind": "transition",
          "from": "nod_assessing",
          "to": "nod_mitigating",
          "on": [
            "evt_disruptionLocal"
          ]
        },
        "edg_e5e": {
          "kind": "transition",
          "from": "nod_mitigating",
          "to": "nod_disruptionClosed",
          "on": [
            "evt_disruptionResolved"
          ]
        },
        "edg_e5f": {
          "from": "nod_assessStart",
          "to": "nod_howBad"
        },
        "edg_e5g": {
          "from": "nod_howBad",
          "to": "nod_declareMajor",
          "kind": "true"
        },
        "edg_e5h": {
          "from": "nod_howBad",
          "to": "nod_handleLocally",
          "kind": "false"
        },
        "edg_e5i": {
          "from": "nod_dutyManager",
          "to": "nod_deskNotifications",
          "kind": "command"
        }
      }
    },
    "cnv_emergencyDesk": {
      "kind": "mixed",
      "name": "Emergency desk",
