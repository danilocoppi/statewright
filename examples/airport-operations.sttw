        "nod_alertDelay": {
          "kind": "call",
          "name": "your flight is delayed",
          "endpoint": "ept_sendAPush"
        },
        "nod_alertEnd": {
          "kind": "end"
        },
        "nod_alertGate": {
          "kind": "call",
          "name": "your gate changed",
          "endpoint": "ept_sendAPush"
        },
        "nod_alertStart": {
          "kind": "start"
        },
        "nod_readFlight": {
          "kind": "call",
          "name": "read the flight",
          "endpoint": "ept_readAFlight"
        },
        "nod_whatChanged": {
          "kind": "switch",
          "name": "what changed?",
          "on": {
            "var": "vars.change"
          }
        }
      },
      "edges": {
        "edg_e1be": {
          "from": "nod_alertStart",
          "to": "nod_readFlight"
        },
        "edg_e1bf": {
          "from": "nod_readFlight",
          "to": "nod_whatChanged"
        },
        "edg_e1bg": {
          "from": "nod_whatChanged",
          "to": "nod_alertGate",
          "kind": "case",
          "case": "gate"
        },
        "edg_e1bh": {
          "from": "nod_alertGate",
          "to": "nod_alertEnd"
        },
        "edg_e1bi": {
          "from": "nod_whatChanged",
          "to": "nod_alertDelay",
          "kind": "case",
          "case": "delay"
        },
        "edg_e1bj": {
          "from": "nod_alertDelay",
          "to": "nod_alertEnd"
        },
        "edg_e1bk": {
          "from": "nod_whatChanged",
          "to": "nod_alertBoarding",
          "kind": "case",
          "case": "boarding"
        },
        "edg_e1bl": {
          "from": "nod_alertBoarding",
          "to": "nod_alertEnd"
        },
        "edg_e1bm": {
          "from": "nod_whatChanged",
          "to": "nod_alertCancelled",
          "kind": "case",
          "case": "cancelled"
        },
        "edg_e1bn": {
          "from": "nod_alertCancelled",
          "to": "nod_alertEnd"
        },
        "edg_e1bo": {
          "from": "nod_whatChanged",
          "to": "nod_alertEnd",
          "kind": "default"
        }
      }
    },
    "cnv_flightLifecycle": {
      "kind": "machine",
      "name": "Flight lifecycle",
      "caption": "A departure, from the published schedule to the hand-off to approach control.",
      "stage": "target",
      "subject": "flight.status",
      "context": "typ_flight",
      "transitions": "complete",
      "nodes": {
        "nod_airborneFlight": {
          "kind": "state",
          "name": "airborne",
          "inner": {
            "canvas": "cnv_climbOut"
          }
        },
        "nod_anyCancel": {
          "kind": "any",
          "name": "any status",
          "except": [
            "nod_departed",
            "nod_airborneFlight",
            "nod_divertedFlight"
          ]
        },
        "nod_boardingFlight": {
          "kind": "state",
          "name": "boarding",
          "category": "processing",
          "inner": {
            "canvas": "cnv_boardingPhases"
          }
        },
        "nod_cancelledFlight": {
          "kind": "state",
          "name": "cancelled",
          "outcome": "failure",
          "terminal": true
        },
        "nod_checkInClosed": {
          "kind": "state",
          "name": "check-in closed",
          "category": "waiting"
        },
        "nod_checkInOpen": {
          "kind": "state",
          "name": "check-in open",
          "category": "processing"
        },
        "nod_deIcingFlight": {
          "kind": "state",
          "name": "de-icing",
          "category": "processing"
        },
        "nod_delayedFlight": {
          "kind": "state",
          "name": "delayed",
          "category": "hold"
        },
        "nod_departed": {
          "kind": "state",
          "name": "departed",
          "outcome": "success",
          "terminal": true
        },
        "nod_divertedFlight": {
          "kind": "state",
          "name": "diverted",
          "outcome": "stopped",
          "terminal": true
        },
        "nod_doorsClosed": {
          "kind": "state",
          "name": "doors closed"
        },
        "nod_flightStart": {
          "kind": "initial"
        },
        "nod_icingChoice": {
          "kind": "choice",
          "name": "icing conditions?"
        },
        "nod_lifeAirline": {
          "kind": "participant",
          "party": "pty_airline"
        },
        "nod_lifeAtc": {
          "kind": "participant",
          "party": "pty_atc"
        },
        "nod_lifeHandler": {
          "kind": "participant",
          "party": "pty_groundHandler"
        },
        "nod_notifySteps": {
          "kind": "steps",
          "action": "act_notifyPassengers"
        },
        "nod_publishFlight": {
          "kind": "entry",
          "name": "POST /flights",
          "via": "ept_publishASchedule",
          "by": "pty_airline"
        },
        "nod_pushedBack": {
          "kind": "state",
          "name": "pushed back"
        },
        "nod_readyForPushback": {
          "kind": "state",
          "name": "ready for pushback",
          "category": "waiting"
        },
        "nod_returnToStand": {
          "kind": "state",
          "name": "returning to stand",
          "category": "hold"
        },
        "nod_scheduled": {
          "kind": "state",
          "name": "scheduled",
          "category": "waiting"
        },
        "nod_slotConfirmed": {
          "kind": "state",
          "name": "slot confirmed",
          "category": "waiting"
        },
        "nod_standAllocated": {
          "kind": "state",
          "name": "stand allocated",
          "category": "waiting"
        },
        "nod_taxiingOut": {
          "kind": "state",
          "name": "taxiing out",
          "category": "processing"
        }
      },
      "edges": {
        "edg_e20": {
          "from": "nod_flightStart",
          "to": "nod_scheduled"
        },
        "edg_e21": {
          "from": "nod_publishFlight",
          "to": "nod_scheduled",
          "actions": [
            {
              "action": "act_publishToDisplays"
            }
          ]
        },
        "edg_e22": {
          "from": "nod_scheduled",
          "to": "nod_slotConfirmed",
          "on": [
            "evt_ctotIssued"
          ],
          "by": "pty_networkManager",
          "intent": "happy"
        },
        "edg_e23": {
          "from": "nod_slotConfirmed",
          "to": "nod_slotConfirmed",
          "on": [
            "evt_ctotRevised"
          ],
          "internal": true,
          "label": "ctot revised"
        },
        "edg_e24": {
          "from": "nod_slotConfirmed",
          "to": "nod_standAllocated",
          "on": [
            "evt_standAllocated"
          ],
          "by": "pty_apoc",
          "intent": "happy"
        },
        "edg_e25": {
          "from": "nod_standAllocated",
          "to": "nod_checkInOpen",
          "after": "tmr_checkInOpens",
          "actions": [
            {
              "action": "act_publishToDisplays"
            },
            {
              "assign": {
                "context.gate": "allocated"
              }
            }
          ],
          "intent": "happy"
        },
        "edg_e26": {
          "from": "nod_checkInOpen",
          "to": "nod_checkInClosed",
          "after": "tmr_checkInCloses",
          "intent": "happy"
        },
        "edg_e27": {
          "from": "nod_checkInClosed",
          "to": "nod_boardingFlight",
          "on": [
            "evt_boardingStarted"
          ],
          "by": "pty_groundHandler",
          "intent": "happy"
        },
        "edg_e28": {
          "from": "nod_boardingFlight",
          "to": "nod_doorsClosed",
          "on": [
            "evt_doorsClosed"
          ],
          "by": "pty_crew",
          "intent": "happy"
        },
        "edg_e29": {
          "from": "nod_doorsClosed",
          "to": "nod_icingChoice",
          "always": true
        },
        "edg_e2a": {
          "from": "nod_icingChoice",
          "to": "nod_deIcingFlight",
          "guard": {
            "guard": "grd_icingConditions"
          },
          "actions": [
            {
              "action": "act_requestDeIcing"
            }
          ]
        },
        "edg_e2b": {
          "from": "nod_icingChoice",
          "to": "nod_readyForPushback",
          "else": true,
          "intent": "happy"
        },
        "edg_e2c": {
          "from": "nod_deIcingFlight",
          "to": "nod_readyForPushback",
          "on": [
            "evt_deicingCompleted"
          ],
          "by": "pty_groundHandler"
        },
        "edg_e2d": {
          "from": "nod_readyForPushback",
          "to": "nod_pushedBack",
          "on": [
            "evt_aircraftOffBlock"
          ],
          "by": "pty_atc",
          "intent": "happy"
        },
        "edg_e2e": {
          "from": "nod_pushedBack",
          "to": "nod_taxiingOut",
          "on": [
            "evt_taxiStarted"
          ],
          "by": "pty_pilot",
          "intent": "happy"
        },
        "edg_e2f": {
          "from": "nod_taxiingOut",
          "to": "nod_airborneFlight",
          "on": [
            "evt_aircraftAirborne"
          ],
          "by": "pty_atc",
          "intent": "happy"
        },
        "edg_e2g": {
          "from": "nod_taxiingOut",
          "to": "nod_returnToStand",
          "on": [
            "evt_aircraftReturning"
          ],
          "by": "pty_pilot",
          "intent": "failure"
        },
        "edg_e2h": {
          "from": "nod_taxiingOut",
          "to": "nod_delayedFlight",
          "after": "tmr_taxiOutLimit",
          "label": "40 min at the holding point"
        },
        "edg_e2i": {
          "from": "nod_returnToStand",
          "to": "nod_standAllocated",
          "on": [
            "evt_aircraftOnBlock"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2j": {
          "from": "nod_airborneFlight",
          "to": "nod_departed",
          "done": true,
          "actions": [
            {
              "action": "act_chargeTheMovement"
            }
          ],
          "intent": "happy"
        },
        "edg_e2k": {
          "from": "nod_airborneFlight",
          "to": "nod_divertedFlight",
          "on": [
            "evt_flightDiverted"
          ],
          "by": "pty_pilot",
          "intent": "failure"
        },
        "edg_e2l": {
          "from": "nod_scheduled",
          "to": "nod_delayedFlight",
          "on": [
            "evt_flightDelayed"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2m": {
          "from": "nod_slotConfirmed",
          "to": "nod_delayedFlight",
          "on": [
            "evt_flightDelayed"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2n": {
          "from": "nod_standAllocated",
          "to": "nod_delayedFlight",
          "on": [
            "evt_flightDelayed"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2o": {
          "from": "nod_checkInOpen",
          "to": "nod_delayedFlight",
          "on": [
            "evt_flightDelayed"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2p": {
          "from": "nod_checkInClosed",
          "to": "nod_delayedFlight",
          "on": [
            "evt_flightDelayed"
          ],
          "actions": [
            {
              "action": "act_notifyPassengers"
            }
          ]
        },
        "edg_e2q": {
          "from": "nod_delayedFlight",
          "to": "nod_slotConfirmed",
          "on": [
            "evt_ctotRevised"
          ],
          "by": "pty_networkManager",
          "actions": [
            {
              "action": "act_publishToDisplays"
            }
          ]
        },
        "edg_e2r": {
          "from": "nod_anyCancel",
          "to": "nod_cancelledFlight",
          "on": [
            "evt_flightCancelled"
          ],
          "by": "pty_airline",
          "actions": [
            {
              "action": "act_notifyPassengers"
            },
            {
              "action": "act_releaseTheStand"
            }
          ],
          "intent": "failure"
        }
      }
    },
    "cnv_fuelling": {
      "kind": "flow",
      "name": "Into-plane fuelling",
      "nodes": {
        "nod_dispatchTruck": {
          "kind": "emit",
          "name": "truck assigned",
          "event": "evt_fuelTruckAssigned"
        },
        "nod_fireCover": {
          "kind": "call",
          "name": "fire cover at the aircraft",
          "party": "pty_fireRescue"
        },
        "nod_fuelEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_fuelOrder": {
          "kind": "wait",
          "name": "the airline's fuel order",
          "on": [
            "evt_fuelOrdered"
          ]
        },
        "nod_fuelReceipt": {
          "kind": "call",
          "name": "fuel receipt to the captain",
          "endpoint": "ept_fuelReceipt"
        },
        "nod_fuelStart": {
          "kind": "start"
        },
        "nod_passengersOnBoard": {
          "kind": "if",
          "name": "passengers on board?",
          "condition": {
            "text": "boarding has started or deboarding has not ended"
          }
        },
        "nod_pumped": {
          "kind": "wait",
          "name": "pumped",
          "on": [
            "evt_fuelCompleted"
          ],
          "after": "tmr_fuellingLimit"
        },
        "nod_pumping": {
          "kind": "wait",
          "name": "pumping",
          "on": [
            "evt_fuelStarted"
          ]
        }
      },
      "edges": {
        "edg_e1c4": {
          "from": "nod_fuelStart",
          "to": "nod_fuelOrder"
        },
        "edg_e1c5": {
          "from": "nod_fuelOrder",
          "to": "nod_passengersOnBoard"
        },
        "edg_e1c6": {
          "from": "nod_passengersOnBoard",
          "to": "nod_fireCover",
          "kind": "true"
        },
        "edg_e1c7": {
          "from": "nod_passengersOnBoard",
          "to": "nod_dispatchTruck",
          "kind": "false"
        },
        "edg_e1c8": {
          "from": "nod_fireCover",
          "to": "nod_dispatchTruck"
        },
        "edg_e1c9": {
          "from": "nod_dispatchTruck",
          "to": "nod_pumping"
        },
        "edg_e1ca": {
          "from": "nod_pumping",
          "to": "nod_pumped"
        },
        "edg_e1cb": {
          "from": "nod_pumped",
          "to": "nod_fuelReceipt"
        },
        "edg_e1cc": {
          "from": "nod_fuelReceipt",
          "to": "nod_fuelEnd"
        }
      }
    },
    "cnv_gateBoarding": {
      "kind": "flow",
      "name": "Gate boarding",
      "nodes": {
        "nod_gateBoardingList": {
          "kind": "call",
          "name": "load the boarding list",
          "endpoint": "ept_boardingList"
        },
        "nod_gateBridge": {
          "kind": "call",
          "name": "dock the jet bridge",
          "party": "pty_groundHandler"
        },
        "nod_gateClose": {
          "kind": "emit",
          "name": "gate closed",
          "event": "evt_gateClosed"
        },
        "nod_gateEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_gateGroups": {
          "kind": "forEach",
          "name": "each boarding group",
          "items": {
            "var": "vars.groups"
          },
          "as": "group",
          "inner": {
            "canvas": "cnv_boardOneGroup"
          }
        },
        "nod_gateRetract": {
          "kind": "call",
          "name": "retract the bridge",
          "party": "pty_groundHandler"
        },
        "nod_gateStart": {
          "kind": "start"
        }
      },
      "edges": {
        "edg_e1j2": {
          "from": "nod_gateStart",
          "to": "nod_gateBridge"
        },
        "edg_e1j3": {
          "from": "nod_gateBridge",
          "to": "nod_gateBoardingList"
        },
        "edg_e1j4": {
          "from": "nod_gateBoardingList",
          "to": "nod_gateGroups"
        },
        "edg_e1j5": {
          "from": "nod_gateGroups",
          "to": "nod_gateClose"
        },
        "edg_e1j6": {
          "from": "nod_gateClose",
          "to": "nod_gateRetract"
        },
        "edg_e1j7": {
          "from": "nod_gateRetract",
          "to": "nod_gateEnd"
        }
      }
    },
