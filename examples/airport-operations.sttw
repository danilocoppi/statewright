    "cnv_billOneOperator": {
      "kind": "flow",
      "name": "Bill one operator",
      "nodes": {
        "nod_charge": {
          "kind": "call",
          "name": "charge the operator",
          "endpoint": "ept_chargeAnOperator"
        },
        "nod_fees": {
          "kind": "parallel",
          "name": "the fees"
        },
        "nod_feesDone": {
          "kind": "join"
        },
        "nod_landingFee": {
          "kind": "assign",
          "name": "landing fee",
          "set": {
            "vars.fees.landing": {
              "var": "vars.operator.landing"
            }
          }
        },
        "nod_opEnd": {
          "kind": "end"
        },
        "nod_opStart": {
          "kind": "start"
        },
        "nod_paidOrNot": {
          "kind": "wait",
          "name": "paid",
          "on": [
            "evt_chargeSucceeded",
            "evt_chargeFailed"
          ],
          "after": "tmr_paymentTerms"
        },
        "nod_parkingFee": {
          "kind": "assign",
          "name": "parking fee",
          "set": {
            "vars.fees.parking": {
              "var": "vars.operator.parking"
            }
          }
        },
        "nod_passengerFee": {
          "kind": "assign",
          "name": "passenger fee",
          "set": {
            "vars.fees.passenger": {
              "var": "vars.operator.passenger"
            }
          }
        },
        "nod_securityFee": {
          "kind": "assign",
          "name": "security fee",
          "set": {
            "vars.fees.security": {
              "var": "vars.operator.security"
            }
          }
        }
      },
      "edges": {
        "edg_e1bs": {
          "from": "nod_opStart",
          "to": "nod_fees"
        },
        "edg_e1bt": {
          "from": "nod_fees",
          "to": "nod_landingFee"
        },
        "edg_e1bu": {
          "from": "nod_landingFee",
          "to": "nod_feesDone"
        },
        "edg_e1bv": {
          "from": "nod_fees",
          "to": "nod_parkingFee"
        },
        "edg_e1bw": {
          "from": "nod_parkingFee",
          "to": "nod_feesDone"
        },
        "edg_e1bx": {
          "from": "nod_fees",
          "to": "nod_passengerFee"
        },
        "edg_e1by": {
          "from": "nod_passengerFee",
          "to": "nod_feesDone"
        },
        "edg_e1bz": {
          "from": "nod_fees",
          "to": "nod_securityFee"
        },
        "edg_e1c0": {
          "from": "nod_securityFee",
          "to": "nod_feesDone"
        },
        "edg_e1c1": {
          "from": "nod_feesDone",
          "to": "nod_charge"
        },
        "edg_e1c2": {
          "from": "nod_charge",
          "to": "nod_paidOrNot"
        },
        "edg_e1c3": {
          "from": "nod_paidOrNot",
          "to": "nod_opEnd"
        }
      }
    },
    "cnv_boardOneGroup": {
      "kind": "flow",
      "name": "Board one group",
      "nodes": {
        "nod_callGroup": {
          "kind": "call",
          "name": "call the group",
          "endpoint": "ept_announce"
        },
        "nod_groupEnd": {
          "kind": "end"
        },
        "nod_groupStart": {
          "kind": "start"
        },
        "nod_groupWait": {
          "kind": "wait",
          "name": "the group has boarded",
          "on": [
            "evt_passengerBoarded"
          ],
          "after": "tmr_pagingInterval"
        }
      },
      "edges": {
        "edg_e1j8": {
          "from": "nod_groupStart",
          "to": "nod_callGroup"
        },
        "edg_e1j9": {
          "from": "nod_callGroup",
          "to": "nod_groupWait"
        },
        "edg_e1ja": {
          "from": "nod_groupWait",
          "to": "nod_groupEnd"
        }
      }
    },
    "cnv_boardOnePassenger": {
      "kind": "flow",
      "name": "Board one passenger",
      "nodes": {
        "nod_boarded": {
          "kind": "emit",
          "name": "boarded",
          "event": "evt_passengerBoarded"
        },
        "nod_notCheckedIn": {
          "kind": "call",
          "name": "check them in at the gate",
          "endpoint": "ept_checkAPassengerIn"
        },
        "nod_oneEnd": {
          "kind": "end"
        },
        "nod_oneStart": {
          "kind": "start"
        },
        "nod_passValid": {
          "kind": "if",
          "name": "valid for this flight?",
          "condition": {
            "text": "the pass is for this flight and gate"
          }
        },
        "nod_scanPass": {
          "kind": "call",
          "name": "scan the boarding pass",
          "endpoint": "ept_recordABoarding"
        },
        "nod_whyRefused": {
          "kind": "switch",
          "name": "why not?",
          "on": {
            "var": "vars.passenger.problem"
          }
        },
        "nod_wrongGate": {
          "kind": "call",
          "name": "send them to the right gate",
          "endpoint": "ept_directions"
        }
      },
      "edges": {
        "edg_e49": {
          "from": "nod_oneStart",
          "to": "nod_scanPass"
        },
        "edg_e4a": {
          "from": "nod_scanPass",
          "to": "nod_passValid"
        },
        "edg_e4b": {
          "from": "nod_passValid",
          "to": "nod_boarded",
          "kind": "true"
        },
        "edg_e4c": {
          "from": "nod_passValid",
          "to": "nod_whyRefused",
          "kind": "false"
        },
        "edg_e4d": {
          "from": "nod_whyRefused",
          "to": "nod_wrongGate",
          "kind": "case",
          "case": "wrongGate"
        },
        "edg_e4e": {
          "from": "nod_whyRefused",
          "to": "nod_notCheckedIn",
          "kind": "case",
          "case": "notCheckedIn"
        },
        "edg_e4f": {
          "from": "nod_whyRefused",
          "to": "nod_oneEnd",
          "kind": "default"
        },
        "edg_e4g": {
          "from": "nod_boarded",
          "to": "nod_oneEnd"
        },
        "edg_e4h": {
          "from": "nod_wrongGate",
          "to": "nod_oneEnd"
        },
        "edg_e4i": {
          "from": "nod_notCheckedIn",
          "to": "nod_oneEnd"
        }
      }
    },
    "cnv_boardingPhases": {
      "kind": "machine",
      "name": "Boarding phases",
      "subject": "flight.boarding",
      "transitions": "complete",
      "nodes": {
        "nod_boardingStopped": {
          "kind": "state",
          "name": "stopped at the gate",
          "category": "hold"
        },
        "nod_everyoneBoarded": {
          "kind": "choice",
          "name": "everyone boarded?"
        },
        "nod_finalCall": {
          "kind": "state",
          "name": "final call",
          "category": "processing"
        },
        "nod_gateClosed": {
          "kind": "state",
          "name": "gate closed",
          "outcome": "success",
          "terminal": true
        },
        "nod_generalBoarding": {
          "kind": "state",
          "name": "general",
          "category": "processing"
        },
        "nod_offloading": {
          "kind": "state",
          "name": "offloading no-shows",
          "category": "hold"
        },
        "nod_phaseResume": {
          "kind": "history",
          "name": "the phase it was in"
        },
        "nod_phasesStart": {
          "kind": "initial"
        },
        "nod_priorityBoarding": {
          "kind": "state",
          "name": "priority",
          "category": "processing"
        }
      },
      "edges": {
        "edg_e2w": {
          "from": "nod_phasesStart",
          "to": "nod_priorityBoarding"
        },
        "edg_e2x": {
          "from": "nod_priorityBoarding",
          "to": "nod_generalBoarding",
          "on": [
            "evt_boardingGeneral"
          ],
          "intent": "happy"
        },
        "edg_e2y": {
          "from": "nod_generalBoarding",
          "to": "nod_finalCall",
          "on": [
            "evt_boardingFinalCall"
          ],
          "intent": "happy"
        },
        "edg_e2z": {
          "from": "nod_finalCall",
          "to": "nod_everyoneBoarded",
          "on": [
            "evt_gateClosed"
          ],
          "intent": "happy"
        },
        "edg_e30": {
          "from": "nod_everyoneBoarded",
          "to": "nod_offloading",
          "else": true,
          "label": "someone is missing"
        },
        "edg_e31": {
          "from": "nod_offloading",
          "to": "nod_gateClosed",
          "on": [
            "evt_bagsOffloaded"
          ],
          "by": "pty_groundHandler"
        },
        "edg_e32": {
          "from": "nod_priorityBoarding",
          "to": "nod_boardingStopped",
          "on": [
            "evt_boardingSuspended"
          ]
        },
        "edg_e33": {
          "from": "nod_generalBoarding",
          "to": "nod_boardingStopped",
          "on": [
            "evt_boardingSuspended"
          ]
        },
        "edg_e34": {
          "from": "nod_finalCall",
          "to": "nod_boardingStopped",
          "on": [
            "evt_boardingSuspended"
          ]
        },
        "edg_e35": {
          "from": "nod_boardingStopped",
          "to": "nod_phaseResume",
          "on": [
            "evt_boardingResumed"
          ]
        },
        "edg_e36": {
          "from": "nod_phaseResume",
          "to": "nod_priorityBoarding",
          "label": "from the start"
        },
        "edg_everyoneBoarded": {
          "from": "nod_everyoneBoarded",
          "to": "nod_gateClosed",
          "guard": {
            "text": "every checked-in passenger has boarded"
          },
          "intent": "happy"
        }
      }
    },
    "cnv_boardingProcedure": {
      "kind": "flow",
      "name": "Boarding procedure",
      "caption": "From the boarding list to doors closed.",
      "vars": "typ_boardingVars",
      "nodes": {
        "nod_announce": {
          "kind": "call",
          "name": "announce boarding",
          "endpoint": "ept_publishASchedule"
        },
        "nod_anyoneMissing": {
          "kind": "while",
          "name": "while someone is missing",
          "condition": {
            "expr": {
              ">": [
                {
                  "var": "vars.missing"
                },
                0
              ]
            },
            "text": "a checked-in passenger has not boarded"
          },
          "inner": {
            "canvas": "cnv_findMissing"
          }
        },
        "nod_boardEnd": {
          "kind": "end",
          "name": "boarded",
          "outcome": "success"
        },
        "nod_boardFail": {
          "kind": "end",
          "name": "flight held",
          "outcome": "failure"
        },
        "nod_boardStart": {
          "kind": "start"
        },
        "nod_closeDoors": {
          "kind": "emit",
          "name": "doors closed",
          "event": "evt_doorsClosed"
        },
        "nod_eachPassenger": {
          "kind": "forEach",
          "name": "each passenger at the gate",
          "items": {
            "var": "vars.passengers"
          },
          "as": "passenger",
          "inner": {
            "canvas": "cnv_boardOnePassenger"
          }
        },
        "nod_gateAgent": {
          "kind": "participant",
          "party": "pty_groundHandler"
        },
        "nod_gateOpen": {
          "kind": "join",
          "name": "gate open"
        },
        "nod_getList": {
          "kind": "call",
          "name": "get the boarding list",
          "endpoint": "ept_boardingList"
        },
        "nod_loadStatus": {
          "kind": "switch",
          "name": "load status?",
          "on": {
            "var": "vars.loadStatus"
          }
        },
        "nod_offloadBags": {
          "kind": "subflow",
          "name": "offload their bags",
          "inner": {
            "canvas": "cnv_offloadNoShows"
          }
        },
        "nod_openGate": {
          "kind": "parallel",
          "name": "open the gate"
        },
        "nod_readyDesk": {
          "kind": "assign",
          "name": "desk ready",
          "set": {
            "vars.missing": 0
          }
        },
        "nod_waitCaptain": {
          "kind": "wait",
          "name": "the captain accepts the load",
          "on": [
            "evt_loadsheetAccepted"
          ]
        }
      },
      "edges": {
        "edg_e3t": {
          "from": "nod_boardStart",
          "to": "nod_getList"
        },
        "edg_e3u": {
          "from": "nod_getList",
          "to": "nod_openGate"
        },
        "edg_e3v": {
          "from": "nod_openGate",
          "to": "nod_announce"
        },
        "edg_e3w": {
          "from": "nod_openGate",
          "to": "nod_readyDesk"
        },
        "edg_e3x": {
          "from": "nod_announce",
          "to": "nod_gateOpen"
        },
        "edg_e3y": {
          "from": "nod_readyDesk",
          "to": "nod_gateOpen"
        },
        "edg_e3z": {
          "from": "nod_gateOpen",
          "to": "nod_eachPassenger"
        },
        "edg_e40": {
          "from": "nod_eachPassenger",
          "to": "nod_anyoneMissing"
        },
        "edg_e41": {
          "from": "nod_anyoneMissing",
          "to": "nod_loadStatus"
        },
        "edg_e42": {
          "from": "nod_loadStatus",
          "to": "nod_closeDoors",
          "kind": "case",
          "case": "complete"
        },
        "edg_e43": {
          "from": "nod_loadStatus",
          "to": "nod_offloadBags",
          "kind": "case",
          "case": "noShows"
        },
        "edg_e44": {
          "from": "nod_loadStatus",
          "to": "nod_boardFail",
          "kind": "default"
        },
        "edg_e45": {
          "from": "nod_offloadBags",
          "to": "nod_closeDoors"
        },
        "edg_e46": {
          "from": "nod_closeDoors",
          "to": "nod_waitCaptain"
        },
        "edg_e47": {
          "from": "nod_waitCaptain",
          "to": "nod_boardEnd"
        },
        "edg_e48": {
          "from": "nod_getList",
          "to": "nod_boardFail",
          "kind": "error"
        }
      }
    },
    "cnv_borderCheck": {
      "kind": "flow",
      "name": "Border check",
      "nodes": {
        "nod_borderEnd": {
          "kind": "end",
          "outcome": "success"
        },
        "nod_borderStart": {
          "kind": "start"
        },
        "nod_checkVisa": {
          "kind": "call",
          "name": "check the visa",
          "endpoint": "ept_visaRecord"
        },
        "nod_eGate": {
          "kind": "call",
          "name": "e-gate",
          "endpoint": "ept_checkATraveller"
        },
        "nod_officer": {
          "kind": "call",
          "name": "an officer checks",
          "party": "pty_borderPolice"
        },
        "nod_refused": {
          "kind": "end",
          "name": "refused entry",
          "outcome": "failure"
        },
        "nod_secondary": {
          "kind": "subflow",
          "name": "secondary inspection",
          "inner": {
            "canvas": "cnv_secondaryInspection"
          }
        },
        "nod_stamp": {
          "kind": "emit",
          "name": "cleared",
          "event": "evt_borderCleared"
        },
        "nod_travelDocument": {
          "kind": "switch",
          "name": "which document?",
          "on": {
            "var": "vars.document.kind"
          }
        },
        "nod_visaCheck": {
          "kind": "if",
          "name": "visa needed?",
          "condition": {
            "text": "the traveller's nationality needs a visa for this destination"
          }
        },
        "nod_watchlist": {
          "kind": "if",
          "name": "on a watch list?",
          "condition": {
            "text": "the database returned a hit"
          }
        }
      },
      "edges": {
        "edg_e1af": {
          "from": "nod_borderStart",
          "to": "nod_travelDocument"
        },
        "edg_e1ag": {
          "from": "nod_travelDocument",
          "to": "nod_eGate",
          "kind": "case",
          "case": "biometricPassport"
        },
        "edg_e1ah": {
          "from": "nod_travelDocument",
          "to": "nod_officer",
          "kind": "default"
        },
        "edg_e1ai": {
          "from": "nod_eGate",
          "to": "nod_officer",
          "kind": "error"
        },
        "edg_e1aj": {
          "from": "nod_eGate",
          "to": "nod_watchlist"
        },
        "edg_e1ak": {
          "from": "nod_officer",
          "to": "nod_visaCheck"
        },
        "edg_e1al": {
          "from": "nod_visaCheck",
          "to": "nod_checkVisa",
          "kind": "true"
        },
        "edg_e1am": {
          "from": "nod_visaCheck",
          "to": "nod_watchlist",
          "kind": "false"
        },
        "edg_e1an": {
          "from": "nod_checkVisa",
          "to": "nod_watchlist"
        },
        "edg_e1ao": {
          "from": "nod_watchlist",
          "to": "nod_secondary",
          "kind": "true"
        },
        "edg_e1ap": {
          "from": "nod_watchlist",
          "to": "nod_stamp",
          "kind": "false"
        },
        "edg_e1aq": {
          "from": "nod_secondary",
          "to": "nod_stamp"
        },
        "edg_e1ar": {
          "from": "nod_secondary",
          "to": "nod_refused",
          "kind": "error"
        },
        "edg_e1as": {
          "from": "nod_stamp",
          "to": "nod_borderEnd"
        }
      }
    },
    "cnv_cabinCleaning": {
      "kind": "flow",
      "name": "Cabin cleaning",
      "nodes": {
        "nod_cleanDone": {
          "kind": "emit",
          "name": "cabin clean",
          "event": "evt_cleaningCompleted"
        },
        "nod_cleanEnd": {
          "kind": "end"
        },
        "nod_cleanKind": {
          "kind": "switch",
          "name": "which clean?",
          "on": {
            "var": "vars.turnaround.minutes"
          }
        },
        "nod_cleanStart": {
          "kind": "start"
        },
        "nod_deepClean": {
          "kind": "call",
          "name": "deep clean",
          "party": "pty_cleaning"
        },
        "nod_fullClean": {
          "kind": "call",
          "name": "full clean",
          "party": "pty_cleaning"
        },
        "nod_quickClean": {
          "kind": "call",
          "name": "quick clean",
          "party": "pty_cleaning"
        }
      },
      "edges": {
        "edg_e1cd": {
          "from": "nod_cleanStart",
          "to": "nod_cleanKind"
        },
        "edg_e1ce": {
          "from": "nod_cleanKind",
          "to": "nod_quickClean",
          "kind": "case",
          "case": "under 35"
        },
        "edg_e1cf": {
          "from": "nod_cleanKind",
          "to": "nod_fullClean",
          "kind": "case",
          "case": "35 to 90"
        },
        "edg_e1cg": {
          "from": "nod_cleanKind",
          "to": "nod_deepClean",
          "kind": "case",
          "case": "night stop"
        },
        "edg_e1ch": {
          "from": "nod_quickClean",
          "to": "nod_cleanDone"
        },
        "edg_e1ci": {
          "from": "nod_fullClean",
          "to": "nod_cleanDone"
        },
        "edg_e1cj": {
          "from": "nod_deepClean",
          "to": "nod_cleanDone"
        },
        "edg_e1ck": {
          "from": "nod_cleanKind",
          "to": "nod_quickClean",
          "kind": "default"
        },
        "edg_e1cl": {
          "from": "nod_cleanDone",
          "to": "nod_cleanEnd"
        }
      }
    },
