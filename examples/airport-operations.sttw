        "edg_e1cy": {
          "kind": "transition",
          "from": "nod_aircraftAccident",
          "to": "nod_standDown",
          "on": [
            "evt_emergencyClosed"
          ]
        },
        "edg_e1cz": {
          "from": "nod_callOutStart",
          "to": "nod_callOut"
        },
        "edg_e1d0": {
          "from": "nod_callOut",
          "to": "nod_callFire"
        },
        "edg_e1d1": {
          "from": "nod_callOut",
          "to": "nod_callHospitals"
        },
        "edg_e1d2": {
          "from": "nod_callOut",
          "to": "nod_callPolice"
        },
        "edg_e1d3": {
