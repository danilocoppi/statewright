    "cnv_secondaryInspection": {
      "kind": "flow",
      "name": "Secondary inspection",
      "nodes": {
        "nod_customsCheck": {
          "kind": "call",
          "name": "customs check",
          "party": "pty_customs"
        },
        "nod_interview": {
          "kind": "call",
          "name": "interview",
          "party": "pty_borderPolice"
        },
        "nod_secondEnd": {
          "kind": "end"
        },
        "nod_secondStart": {
          "kind": "start"
        }
      },
      "edges": {
        "edg_e1at": {
          "from": "nod_secondStart",
          "to": "nod_interview"
        },
        "edg_e1au": {
          "from": "nod_interview",
          "to": "nod_customsCheck"
        },
        "edg_e1av": {
          "from": "nod_customsCheck",
          "to": "nod_secondEnd"
        }
      }
    },
    "cnv_securityLane": {
      "kind": "machine",
      "name": "Security lane",
      "caption": "One of 38 lanes. A lane in alarm stops taking trays until the alarm is resolved.",
      "subject": "lane.status",
      "transitions": "complete",
      "nodes": {
        "nod_laneAlarm": {
          "kind": "state",
          "name": "alarm",
          "category": "hold",
          "inner": {
            "canvas": "cnv_alarmResolution"
          }
        },
        "nod_laneBusy": {
          "kind": "state",
          "name": "queue over 10 min",
          "category": "hold"
        },
        "nod_laneClosed": {
          "kind": "state",
          "name": "closed",
          "category": "waiting"
        },
        "nod_laneOfficer": {
          "kind": "participant",
          "party": "pty_security"
        },
        "nod_laneOpen": {
          "kind": "state",
          "name": "open",
          "category": "processing"
        },
        "nod_laneOpening": {
          "kind": "state",
          "name": "opening",
          "category": "processing"
        },
        "nod_lanePaused": {
          "kind": "state",
          "name": "paused",
          "category": "waiting"
        },
        "nod_laneStart": {
          "kind": "initial"
        }
      },
      "edges": {
        "edg_e19y": {
          "from": "nod_laneStart",
          "to": "nod_laneClosed"
        },
        "edg_e19z": {
          "from": "nod_laneClosed",
          "to": "nod_laneOpening",
          "on": [
            "evt_laneStaffed"
          ],
          "by": "pty_security",
          "intent": "happy"
        },
        "edg_e1a0": {
          "from": "nod_laneOpening",
          "to": "nod_laneOpen",
          "on": [
            "evt_laneSelfTested"
          ],
          "intent": "happy"
        },
        "edg_e1a1": {
          "from": "nod_laneOpen",
          "to": "nod_laneBusy",
          "on": [
            "evt_queueLong"
          ]
        },
        "edg_e1a2": {
          "from": "nod_laneBusy",
          "to": "nod_laneOpen",
          "on": [
            "evt_queueNormal"
          ]
        },
        "edg_e1a3": {
          "from": "nod_laneOpen",
          "to": "nod_laneAlarm",
          "on": [
            "evt_screeningAlarm"
          ]
        },
        "edg_e1a4": {
          "from": "nod_laneBusy",
          "to": "nod_laneAlarm",
          "on": [
            "evt_screeningAlarm"
          ]
        },
        "edg_e1a5": {
          "from": "nod_laneAlarm",
          "to": "nod_laneOpen",
          "done": true
        },
        "edg_e1a6": {
          "from": "nod_laneOpen",
          "to": "nod_lanePaused",
          "on": [
            "evt_laneBreak"
          ],
          "by": "pty_security"
        },
        "edg_e1a7": {
          "from": "nod_lanePaused",
          "to": "nod_laneOpen",
          "after": "tmr_break"
        },
        "edg_e1a8": {
          "from": "nod_laneOpen",
          "to": "nod_laneClosed",
          "on": [
            "evt_laneClosed"
          ],
          "by": "pty_security"
        }
      }
    },
    "cnv_standLifecycle": {
      "kind": "machine",
      "name": "Stand lifecycle",
      "subject": "stand.status",
      "transitions": "complete",
      "nodes": {
        "nod_standAny": {
          "kind": "any",
          "except": [
            "nod_standBlocked"
          ]
        },
        "nod_standBlocked": {
          "kind": "state",
          "name": "out of service",
          "category": "hold"
        },
        "nod_standClearing": {
          "kind": "state",
          "name": "clearing",
          "category": "processing"
        },
        "nod_standFree": {
          "kind": "state",
          "name": "free",
          "category": "waiting"
        },
        "nod_standOccupied": {
          "kind": "state",
          "name": "occupied",
          "category": "processing"
        },
        "nod_standPlanned": {
          "kind": "state",
          "name": "planned",
          "category": "waiting"
        },
        "nod_standStart": {
          "kind": "initial"
        }
      },
      "edges": {
        "edg_et0": {
          "from": "nod_standStart",
          "to": "nod_standFree"
        },
        "edg_et1": {
          "from": "nod_standFree",
          "to": "nod_standPlanned",
          "on": [
            "evt_standAllocated"
          ],
          "intent": "happy"
        },
        "edg_et2": {
          "from": "nod_standPlanned",
          "to": "nod_standFree",
          "on": [
            "evt_standDeallocated"
          ]
        },
        "edg_et3": {
          "from": "nod_standPlanned",
          "to": "nod_standOccupied",
          "on": [
            "evt_aircraftOnBlock"
          ],
          "intent": "happy"
        },
        "edg_et4": {
          "from": "nod_standOccupied",
          "to": "nod_standClearing",
          "on": [
            "evt_aircraftOffBlock"
          ],
          "intent": "happy"
        },
        "edg_et5": {
          "from": "nod_standClearing",
          "to": "nod_standFree",
          "on": [
            "evt_standInspected"
          ],
          "by": "pty_groundHandler",
          "intent": "happy"
        },
        "edg_et6": {
          "from": "nod_standAny",
          "to": "nod_standBlocked",
          "on": [
            "evt_standOutOfService"
          ],
          "by": "pty_maintenance"
        },
        "edg_et7": {
          "from": "nod_standBlocked",
          "to": "nod_standFree",
          "on": [
            "evt_standReturned"
          ],
          "by": "pty_maintenance"
        }
      }
    },
