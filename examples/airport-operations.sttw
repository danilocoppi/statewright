  "project": {
    "id": "prj_airportOperations",
    "name": "Airport operations",
    "description": "An international airport of four terminals: who works with whom, every flight from slot to on-block, each bag from the drop to the hold, 120 stands, the turnaround at each of them, security, borders, de-icing and the desk that handles what goes wrong."
  },
