      "starts": [
        {
          "by": "Guest",
          "id": "nod_book",
          "kind": "entry",
          "name": "POST /bookings",
          "to": "requested",
          "via": "POST /bookings"
        }
      ],
      "states": [
        {
          "id": "nod_confirmed",
          "name": "confirmed"
        },
        {
          "final": true,
          "id": "nod_declined",
          "name": "declined",
          "outcome": "failure"
        },
        {
          "final": true,
          "id": "nod_noShow",
          "name": "no-show",
          "outcome": "stopped"
        },
        {
          "category": "waiting",
          "id": "nod_requested",
          "name": "requested"
        },
        {
          "final": true,
          "id": "nod_seated",
          "name": "seated",
          "outcome": "success"
        }
      ],
      "subject": "booking.status",
      "transitions": [
        {
          "after": {
            "duration": "PT30M",
            "timer": "grace period"
          },
          "from": "confirmed",
          "id": "edg_confirmedNoShow",
          "intent": "failure",
          "to": "no-show"
        },
        {
          "from": "confirmed",
          "id": "edg_confirmedSeated",
          "intent": "happy",
          "on": [
            "guest.arrived"
          ],
          "to": "seated"
        },
        {
          "from": "entry:nod_book",
          "id": "edg_postBookingsRequested",
          "to": "requested"
        },
        {
          "from": "requested",
          "id": "edg_requestedConfirmed",
          "intent": "happy",
          "on": [
            "booking.confirmed"
          ],
          "to": "confirmed"
        },
        {
          "from": "requested",
          "id": "edg_requestedDeclined",
          "intent": "failure",
          "on": [
            "booking.declined"
          ],
          "to": "declined"
        }
      ]
    }
  ],
