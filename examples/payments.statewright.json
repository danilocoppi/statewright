  "annotations": {
    "scenarios": {
      "scn_paysInTime": {
        "name": "Pays in time",
        "description": "A cross-border send that is paid, converted and paid out in full before the offer expires.",
        "canvas": "cnv_lifecycle",
        "start": {
          "at": "2026-01-05T09:00:00Z",
          "context": {
            "nod_expiryClock": {
              "expiresAt": "2026-01-15T09:00:00Z"
            }
          }
        },
        "steps": [
          {
            "do": {
              "event": "evt_payinDetected"
            },
            "caption": "The payer's money is seen: the expiry clock stops.",
            "reached": {
              "active": [
                "nod_complianceHold/nod_clear",
                "nod_expiryClock/nod_stopped",
                "nod_sendCrossBorder/nod_awaitingFunds"
              ]
            }
          },
          {
            "do": {
              "event": "evt_payinConfirmed"
            },
            "caption": "The pay-in is confirmed, and the money is converted.",
            "reached": {
              "active": [
