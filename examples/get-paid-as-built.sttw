  "canvases": {
    "cnv_open": {
      "kind": "machine",
      "name": "Open",
      "stage": "as-built",
      "subject": "transaction.status",
      "transitions": "partial",
      "nodes": {
        "nod_awaitingPayment": {
          "kind": "state",
          "name": "awaiting_payment",
          "category": "waiting",
          "statuses": [
            "sts_awaitingPayment"
          ],
          "summary": "instructions issued"
        },
        "nod_created": {
          "kind": "state",
          "name": "created",
          "category": "waiting",
          "statuses": [
            "sts_created"
          ],
          "summary": "crypto link, no lock"
        },
        "nod_openStart": {
          "kind": "initial"
        },
        "nod_otherTypes": {
          "kind": "entry",
          "name": "create (other types)"
        },
        "nod_underpaid": {
          "kind": "state",
          "name": "underpaid",
          "summary": "same exits as awaiting\nno writer in deployed code",
          "provenance": "legacy"
        }
      },
      "edges": {
        "edg_createOtherTypesAwaitingPayment": {
          "from": "nod_otherTypes",
          "to": "nod_awaitingPayment"
        },
        "edg_createdAwaitingPayment": {
          "from": "nod_created",
          "to": "nod_awaitingPayment",
          "on": [
            "evt_payerLocked"
          ],
          "intent": "happy",
          "label": "payer lock"
        },
        "edg_initialCreated": {
          "from": "nod_openStart",
          "to": "nod_created"
        }
      }
    },
    "cnv_transaction": {
      "kind": "machine",
      "name": "Transaction",
      "kicker": "As built · transaction",
      "title": "The one transition table every transaction shares",
      "caption": "Nine statuses, one table (core.js:34-52). Seven of sixteen status updates call it; seven encode the same edges in their own conditions, and advanceStatus trusts its callers.",
      "stage": "as-built",
      "subject": "transaction.status",
      "transitions": "partial",
      "nodes": {
        "nod_cancelled": {
          "kind": "state",
          "name": "cancelled",
          "outcome": "stopped",
          "terminal": true,
          "statuses": [
            "sts_cancelled"
          ],
          "summary": "owner or admin"
        },
        "nod_completed": {
          "kind": "state",
          "name": "completed",
          "outcome": "success",
          "terminal": true,
          "statuses": [
            "sts_completed"
          ],
          "summary": "or partially_completed\ncompletionStatusFor"
        },
        "nod_expired": {
          "kind": "state",
          "name": "expired",
          "outcome": "stopped",
          "statuses": [
            "sts_expired"
          ]
        },
        "nod_failed": {
          "kind": "state",
          "name": "failed",
          "outcome": "failure",
          "terminal": true,
          "statuses": [
            "sts_failed"
          ],
          "summary": "failureCode: any string"
        },
        "nod_open": {
          "kind": "state",
          "name": "open",
          "summary": "shared exits",
          "inner": {
            "canvas": "cnv_open"
          }
        },
        "nod_processing": {
          "kind": "state",
          "name": "processing",
          "statuses": [
            "sts_processing"
          ],
          "summary": "not a confirmation",
          "provenance": "built",
          "evidence": [
            {
              "kind": "code",
              "path": "src/core.js",
              "lines": "34-52"
            }
          ]
        },
        "nod_start": {
          "kind": "initial"
        }
      },
      "edges": {
        "edg_expiredCancelled": {
          "from": "nod_expired",
          "to": "nod_cancelled",
          "on": [
            "evt_cancel"
          ],
          "by": "pty_admin",
          "label": "owner or admin cancel"
        },
        "edg_expiredProcessing": {
          "from": "nod_expired",
          "to": "nod_processing",
          "on": [
            "evt_custodyOverride"
          ],
          "by": "pty_admin",
          "label": "onChain custody override (off-table)"
        },
        "edg_initialOpen": {
          "from": "nod_start",
          "to": "nod_open"
        },
        "edg_openCancelled": {
          "from": "nod_open",
          "to": "nod_cancelled",
          "on": [
            "evt_cancel"
          ],
          "by": "pty_admin",
          "label": "owner cancel (admin too)"
        },
        "edg_openExpired": {
          "from": "nod_open",
          "to": "nod_expired",
          "after": "tmr_deadline",
          "label": "deadline: 10-min sweep · lazy read"
        },
        "edg_openFailed": {
          "from": "nod_open",
          "to": "nod_failed",
          "on": [
            "evt_pspPaymentFailed",
            "evt_signingRefused"
          ],
          "intent": "failure"
        },
        "edg_openProcessing": {
          "from": "nod_open",
          "to": "nod_processing",
          "on": [
            "evt_pspReceived",
            "evt_depositSettled",
            "evt_adminTrigger"
          ],
          "intent": "happy"
        },
        "edg_processingCompleted": {
          "from": "nod_processing",
          "to": "nod_completed",
          "on": [
            "evt_settled"
          ],
          "intent": "happy"
        },
        "edg_processingFailed": {
          "from": "nod_processing",
          "to": "nod_failed",
          "on": [
            "evt_markFailed",
            "evt_pspPaymentFailed"
          ],
          "intent": "failure"
        }
      }
    }
  },
  "annotations": {
    "findings": {
      "fnd_H1": {
        "code": "H1",
        "title": "advanceStatus trusts its callers",
        "severity": "high",
        "description": "Eight call sites move transactions without checking the table.",
        "targets": [
          "nod_processing"
        ],
        "source": "audit"
      },
      "fnd_H3": {
        "code": "H3",
        "title": "failureCode accepts any string",
        "severity": "medium",
        "targets": [
          "nod_failed"
        ],
        "source": "audit"
      }
    },
    "scenarios": {
      "scn_paidBeforeTheSweep": {
        "name": "Paid before the deadline sweep",
        "description": "A transaction the payer locks and pays, settled before the sweep can expire it.",
        "canvas": "cnv_transaction",
        "start": {
          "at": "2026-01-05T09:00:00Z"
        },
        "steps": [
          {
            "do": {
              "event": "evt_payerLocked"
            },
            "caption": "The payer locks the payment; the transaction waits for the money.",
            "reached": {
              "active": [
                "nod_open/nod_awaitingPayment"
              ]
            }
          },
          {
            "do": {
              "event": "evt_pspReceived"
            },
            "caption": "The payment provider receives the money.",
            "reached": {
              "active": [
                "nod_processing"
              ]
            }
          },
          {
            "do": {
              "event": "evt_settled"
            },
            "caption": "The money settles: the transaction is complete.",
            "reached": {
              "active": [
                "nod_completed"
              ],
              "ended": "done"
            }
          }
        ]
      }
    }
  },
